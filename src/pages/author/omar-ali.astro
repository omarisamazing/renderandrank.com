---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Section from '../../components/ui/Section.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { siteConfig } from '../../config/site';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteConfig.url}/author/omar-ali`,
  name: siteConfig.founder.name,
  jobTitle: siteConfig.founder.role,
  description: siteConfig.founder.bio,
  url: `${siteConfig.url}/author/omar-ali`,
  knowsAbout: siteConfig.founder.knowsAbout,
  sameAs: siteConfig.founder.sameAs,
  worksFor: { '@id': `${siteConfig.url}/#business` },
};
---

<Layout
  title={`${siteConfig.founder.name}, ${siteConfig.founder.role} | ${siteConfig.name}`}
  description={`${siteConfig.founder.name} — ${siteConfig.founder.role}. ${siteConfig.founder.credentials}. Articles on local SEO, schema, and AI search visibility.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <div class="border-b border-hairline bg-canvas py-16 md:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center" data-reveal-group>
        <Eyebrow data-reveal>Author</Eyebrow>
        <h1 class="display-lg mt-4 text-ink" data-reveal>{siteConfig.founder.name}</h1>
        <p class="subhead mt-5 text-ink" data-reveal>{siteConfig.founder.role}</p>
        <p class="body mt-5 text-ink" data-reveal>{siteConfig.founder.bio}</p>
        <p class="body-sm mt-4 text-ink" data-reveal>{siteConfig.founder.credentials}</p>
      </div>
    </div>
  </div>

  <Section divider>
    <div data-reveal-group>
      <Eyebrow data-reveal>Articles</Eyebrow>
      <h2 class="display-md mt-4 text-ink" data-reveal>Written by {siteConfig.founder.name.split(' ')[0]}</h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {posts
        .filter((post) => post.data.author === siteConfig.founder.name)
        .map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="flex flex-col rounded-lg border border-hairline bg-canvas p-6 transition-colors hover:border-ink/25 md:p-7"
            data-reveal
          >
            <h3 class="card-title text-ink">{post.data.title}</h3>
            <p class="body-sm mt-3 text-ink">{post.data.description}</p>
            <p class="caption mt-4 text-ink">
              {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
          </a>
        ))}
    </div>
  </Section>

  <CtaBanner />
</Layout>
