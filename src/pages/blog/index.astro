---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Section from '../../components/ui/Section.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const pillars = [
  { id: 'generative-search', label: 'Generative Search & AEO' },
  { id: 'local-seo', label: 'Local SEO & GBP Engineering' },
  { id: 'technical-schema', label: 'Technical Schema & Entity Graphing' },
  { id: 'commercial', label: 'Commercial' },
];

const byPillar = pillars.map((pillar) => ({
  ...pillar,
  posts: posts.filter((p) => p.data.topic === pillar.id),
}));

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
    itemListElement: posts.map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://renderandrank.com/blog/${post.id}/`,
      name: post.data.title,
    })),
};
---

<Layout
  title="Blog — Search Engineering Notes | Render and Rank"
  description="High-integrity search engineering insights: Maps 3-pack, schema and entity graphing, and generative search visibility. Written by a lead search engineer, verified in production."
  keywords="local SEO blog, AEO guide, GEO audit, AI search visibility, Google Maps 3-pack guide, JSON-LD schema guide"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <div class="border-b border-hairline bg-canvas py-16 md:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center" data-reveal-group>
        <Eyebrow data-reveal>Editorial engine</Eyebrow>
        <h1 class="display-lg mt-4 text-ink" data-reveal>
          Search engineering, verified in production
        </h1>
        <p class="subhead mt-5 text-ink" data-reveal>
          No slide decks. Every article ships with the technical execution behind
          it — schema you can view-source, audits you can reproduce.
        </p>
      </div>
    </div>
  </div>

  {byPillar.map((pillar) => pillar.posts.length > 0 && (
    <Section divider>
      <div data-reveal-group>
        <Eyebrow data-reveal>{pillar.label}</Eyebrow>
        <h2 class="display-md mt-4 text-ink" data-reveal>{pillar.label}</h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {pillar.posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="flex flex-col rounded-lg border border-hairline bg-canvas p-6 transition-colors hover:border-ink/25 md:p-7"
            data-reveal
          >
            <p class="eyebrow text-ink">
              {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
            <h3 class="card-title mt-3 text-ink">{post.data.title}</h3>
            <p class="body-sm mt-3 text-ink">{post.data.description}</p>
            <p class="caption mt-4 text-ink">By {post.data.author} &middot; {Math.max(1, Math.round((post.body ?? '').split(/\s+/).filter(Boolean).length / 200))} min read →</p>
          </a>
        ))}
      </div>
    </Section>
  ))}

  <CtaBanner />
</Layout>
