---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogPostPage from '../../components/BlogPostPage.astro';
import { siteConfig } from '../../config/site';
import { blogTopicLabel } from '../../i18n/utils';
import { defaultLang } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const updated = post.data.updatedDate ?? post.data.publishDate;
const url = `${siteConfig.url}/blog/${post.id}/`;
---

<Layout
  title={`${post.data.title} | ${siteConfig.name} Blog`}
  description={post.data.description}
  canonical={url}
  ogType="article"
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={updated.toISOString()}
  articleSection={blogTopicLabel(defaultLang, post.data.topic)}
>
  <BlogPostPage post={post} localePrefix="" />
</Layout>
