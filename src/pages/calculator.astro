---
import Layout from '../layouts/Layout.astro';
import Section from '../components/ui/Section.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import CtaBanner from '../components/CtaBanner.astro';

const method = [
  {
    title: 'The top three take most of the clicks',
    body: 'Positional click studies put the top-three Maps share near two thirds of commercial local clicks. Below them you compete for the remainder — and only a fraction of that is winnable without fixing visibility, which is what the calculator models.',
  },
  {
    title: 'AI recommendations arrive pre-sold',
    body: 'Someone who asks an assistant for a recommendation and gets your name has already been vetted for them. There is no comparison-shopping step left.',
  },
  {
    title: 'Where the estimate is conservative',
    body: 'The base figure uses mid-range click-to-call and close rates for your trade, and only the capturable share of searches — not total demand. Open “How this is calculated” to see every input, source, and the pessimistic/optimistic range.',
  },
  {
    title: 'What it cannot know',
    body: 'Search volume, seasonality and your own capacity. Treat the number as a starting point for a conversation, not a forecast.',
  },
];
---

<Layout
  title="ROI calculator | Render and Rank"
  description="Estimate the monthly revenue going to competitors who hold the Google Maps 3-pack and get named by AI answer engines."
  keywords="local SEO ROI calculator, Google Maps 3-pack revenue, lost leads calculator, local search ROI, map pack revenue estimator"
>
  <div class="border-b border-hairline bg-canvas py-16 md:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center" data-reveal-group>
        <Eyebrow data-reveal>Calculator</Eyebrow>
        <h1 class="display-lg mt-4 text-ink" data-reveal>
          What missing the top 3 costs, in dollars
        </h1>
        <p class="subhead mt-5 text-ink" data-reveal>
          Set your job value, search volume and current position. We will show the
          calls and jobs going elsewhere.
        </p>
      </div>
    </div>
  </div>

  <RoiCalculator showHeader={false} />

  <Section divider>
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <Eyebrow data-reveal>Method</Eyebrow>
      <h2 class="display-md mt-4 text-ink" data-reveal>
        How the number is built, and where it stops
      </h2>
    </div>

    <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-2" data-reveal-group>
      {
        method.map((item) => (
          <div class="rounded-lg border border-hairline bg-surface-soft p-6" data-reveal>
            <h3 class="card-title text-ink">{item.title}</h3>
            <p class="body-sm mt-3 text-ink">{item.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <CtaBanner />
</Layout>
