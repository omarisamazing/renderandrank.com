---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import CtaBanner from '../components/CtaBanner.astro';
---

<Layout
  title="Case studies | Render and Rank"
  description="Ranking transformations, Google Maps 3-pack jumps and AI citation results for local businesses, with before-and-after numbers."
>
  <div class="border-b border-hairline bg-canvas py-16 md:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center" data-reveal-group>
        <Eyebrow data-reveal>Case studies</Eyebrow>
        <h1 class="display-lg mt-4 text-ink" data-reveal>
          Rankings, calls and revenue
        </h1>
        <p class="subhead mt-5 text-ink" data-reveal>
          Each of these businesses started on page three, or absent from AI answers
          entirely. The measurements are taken the same way before and after.
        </p>
      </div>
    </div>
  </div>

  <PortfolioGrid showHeader={false} />
  <TestimonialsSection />
  <CtaBanner />
</Layout>
