---
import Layout from '../../layouts/Layout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { services } from '../../data/services';

const service = services.find((s) => s.slug === 'aeo-geo')!;
---

<Layout
  title={`${service.title} | Render and Rank`}
  description={service.shortDescription}
  keywords="AEO, GEO, answer engine optimization, generative engine optimization, ChatGPT SEO, Perplexity, Google AI Overviews, AI citations"
>
  <ServiceDetail
    service={service}
    block="lilac"
    lede="When the answer replaces the search results"
  />
  <CtaBanner />
</Layout>
