---
import Layout from '../../layouts/Layout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { services } from '../../data/services';

const service = services.find((s) => s.slug === 'google-maps')!;
---

<Layout
  title={`${service.title} | Render and Rank`}
  description={service.shortDescription}
  keywords="Google Maps 3-pack, Google Business Profile, map pack ranking, review velocity, proximity signals, local pack"
>
  <ServiceDetail
    service={service}
    block="mint"
    lede="Three slots decide the whole market"
  />
  <CtaBanner />
</Layout>
