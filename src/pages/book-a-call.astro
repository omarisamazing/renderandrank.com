---
import Layout from '../layouts/Layout.astro';
import BookCallPage from '../components/BookCallPage.astro';
import { siteConfig } from '../config/site';

const { calCom } = siteConfig;
---

<Layout
  title="Book a discovery call | Render and Rank"
  description={`Book a ${calCom.duration} technical search and AI visibility review with Omar Ali. We inspect your live geo-grid and map the route to the Maps 3-pack.`}
  keywords="book a local SEO call, discovery call, geo-grid audit, Google Maps consultation, AI visibility review, Omar Ali call"
  showBookingPrompt={false}
  loadCal
>
  <BookCallPage />
</Layout>
