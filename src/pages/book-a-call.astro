---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import CalInline from '../components/CalInline.astro';
import { siteConfig } from '../config/site';
import { Check, Mail, Phone, Video } from '@lucide/astro';
import { Picture } from 'astro:assets';
import founderAvatar from '../assets/founder-omar-ali.png';

const { calCom, founder, contact } = siteConfig;

const agenda = [
  {
    title: 'Live geo-grid audit',
    body: 'We sample your rank across your service radius while you watch, and find where the calls stop.',
  },
  {
    title: 'Answer-engine check',
    body: 'We ask ChatGPT and Gemini your category questions in real time and see whether you come up.',
  },
  {
    title: 'Competitor review',
    body: 'Which competitors are breaking Google guidelines, and which positions are realistically winnable.',
  },
  {
    title: 'A ninety-day plan',
    body: 'Deliverables, sequence and what call volume to expect. Yours to keep either way.',
  },
];
---

<Layout
  title="Book a discovery call | Render and Rank"
  description={`Book a ${calCom.duration} technical search and AI visibility review with Omar Ali. We inspect your live geo-grid and map the route to the Maps 3-pack.`}
  keywords="book a local SEO call, discovery call, geo-grid audit, Google Maps consultation, AI visibility review, Omar Ali call"
  showBookingPrompt={false}
>
  <div class="section-y">
    <div class="container-page">
      <!-- Header -->
      <div class="mx-auto max-w-2xl text-center" data-reveal-group>
        <Eyebrow data-reveal>Book a call</Eyebrow>
        <h1 class="display-lg mt-4 text-ink" data-reveal>
          {calCom.duration} with the person doing the work
        </h1>
        <p class="subhead mt-5 text-ink" data-reveal>
          Pick a time that suits you. We pull your live geo-grid on the call, test
          your AI visibility, and you leave with the plan.
        </p>
      </div>

      <!-- Scheduler Hero Card (Wide for 3-column desktop view) -->
      <div class="mt-10 mx-auto max-w-5xl" data-reveal>
        <div
          class="overflow-hidden rounded-lg border border-hairline bg-canvas p-1 sm:p-3 md:p-6"
        >
          <CalInline minHeight={620} />
        </div>
      </div>

      <!-- What to expect / Agenda & Guarantee Section -->
      <div class="mt-16 mx-auto max-w-5xl border-t border-hairline pt-12 md:pt-16" data-reveal-group>
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <!-- Left: Agenda (col-span-7) -->
          <div class="lg:col-span-7" data-reveal>
            <Eyebrow>Diagnostic review</Eyebrow>
            <h2 class="card-title mt-2 text-ink">What happens on the call</h2>
            <p class="body-sm mt-2 text-ink">
              This is a hands-on technical diagnostic. We look at real search telemetry and leave you with actionable data.
            </p>

            <ol class="mt-6 flex flex-col gap-5">
              {
                agenda.map((item, i) => (
                  <li class="flex gap-4">
                    <span
                      class="numeric flex size-8 shrink-0 items-center justify-center rounded-full bg-surface-soft text-[0.875rem] font-medium text-ink"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <div>
                      <p class="label text-ink font-semibold">{item.title}</p>
                      <p class="body-sm mt-1 text-ink">{item.body}</p>
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>

          <!-- Right: Host & Guarantee Card (col-span-5) -->
          <div class="lg:col-span-5 flex flex-col gap-6" data-reveal data-reveal-delay="0.1">
            <!-- Host Card -->
            <div class="rounded-lg border border-hairline bg-canvas p-6">
              <div class="flex items-center gap-4 border-b border-hairline pb-4">
                <Picture
                  src={founderAvatar}
                  formats={['avif', 'webp']}
                  fallbackFormat="png"
                  alt=""
                  width={112}
                  height={112}
                  loading="lazy"
                  decoding="async"
                  class="size-14 shrink-0 rounded-full border border-hairline object-cover object-top"
                />
                <div>
                  <p class="card-title text-ink">{founder.name}</p>
                  <p class="body-sm mt-0.5 text-ink">{founder.role}</p>
                </div>
              </div>

              <ul class="mt-4 flex flex-col gap-2.5">
                <li class="caption inline-flex items-center gap-2.5 text-ink">
                  <Video class="size-4 shrink-0" aria-hidden="true" />
                  {calCom.duration} video call &middot; {calCom.platform}
                </li>
                <li class="caption inline-flex items-center gap-2.5 text-ink">
                  <Phone class="size-4 shrink-0" aria-hidden="true" />
                  {contact.phone}
                </li>
                <li class="caption inline-flex items-center gap-2.5 text-ink">
                  <Mail class="size-4 shrink-0" aria-hidden="true" />
                  {contact.email}
                </li>
              </ul>
            </div>

            <!-- Guarantee Box -->
            <div class="rounded-lg bg-block-lime p-5">
              <p class="label inline-flex items-center gap-2 font-semibold text-ink">
                <Check class="size-4 shrink-0" aria-hidden="true" />
                No pitch promise
              </p>
              <p class="body-sm mt-1.5 text-ink">
                This is a diagnostic, not a sales pitch. If we are not the right fit for your local market, we will say so honestly and point you to better alternatives.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
