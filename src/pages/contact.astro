---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/ui/Eyebrow.astro';
import Button from '../components/ui/Button.astro';
import BookCallButton from '../components/BookCallButton.astro';
import { siteConfig } from '../config/site';
import { Clock, Mail, MapPin, Phone } from '@lucide/astro';

const { contact, founder, forms } = siteConfig;

const details = [
  { icon: Phone, label: 'Direct line', value: contact.phone, href: `tel:${contact.phone.replace(/[^\d+]/g, '')}` },
  { icon: Mail, label: 'Email', value: contact.email, href: `mailto:${contact.email}` },
  { icon: MapPin, label: 'Based in', value: 'Austin, TX — working worldwide' },
  { icon: Clock, label: 'Reply time', value: 'Usually within four business hours' },
];

const services = [
  { value: 'full', label: 'Full local search and AI engine' },
  { value: 'maps', label: 'Google Maps 3-pack' },
  { value: 'aeo-geo', label: 'Answer and generative engines' },
  { value: 'audit', label: 'Free diagnostic audit' },
  { value: 'other', label: 'Something else' },
];

const inputClass =
  'mt-2 w-full rounded-md border border-hairline bg-canvas px-3.5 py-3 text-[1.0625rem] text-ink placeholder:text-muted-foreground focus-visible:border-ink focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ink';
---

<Layout
  title="Contact | Render and Rank"
  description="Ask a question or request a free Google Maps and AI visibility audit. Omar Ali replies personally, usually within four business hours."
>
  <!-- Header -->
  <div class="border-b border-hairline bg-canvas py-16 md:py-20">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center" data-reveal-group>
        <Eyebrow data-reveal>Contact</Eyebrow>
        <h1 class="display-lg mt-4 text-ink" data-reveal>
          Tell us about your market
        </h1>
        <p class="subhead mt-5 text-ink" data-reveal>
          A quick question or a full geo-grid audit — either way it reaches Omar
          directly, and he answers.
        </p>
      </div>
    </div>
  </div>

  <div class="section-y">
    <div class="container-page">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- Details -->
        <aside class="lg:col-span-5" data-reveal>
          <div class="rounded-lg border border-hairline bg-canvas p-6 md:p-7">
            <div class="flex items-center gap-4 border-b border-hairline pb-5">
              <img
                src={founder.avatar}
                alt=""
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
                class="size-12 shrink-0 rounded-full border border-hairline object-cover object-top"
              />
              <div>
                <p class="label text-ink">{founder.name}</p>
                <p class="caption mt-0.5 text-ink">{founder.role}</p>
              </div>
            </div>

            <dl class="mt-6 flex flex-col gap-5">
              {
                details.map((item) => (
                  <div class="flex gap-3.5">
                    <item.icon class="mt-0.5 size-4 shrink-0 text-ink" aria-hidden="true" />
                    <div>
                      <dt class="caption text-ink">{item.label}</dt>
                      <dd class="body-sm mt-0.5 text-ink">
                        {item.href ? (
                          <a
                            href={item.href}
                            class="underline decoration-hairline underline-offset-4 transition-colors hover:decoration-ink"
                          >
                            {item.value}
                          </a>
                        ) : (
                          item.value
                        )}
                      </dd>
                    </div>
                  </div>
                ))
              }
            </dl>

            <div class="mt-7 border-t border-hairline pt-6">
              <p class="body-sm text-ink">Would you rather just talk?</p>
              <div class="mt-3">
                <BookCallButton size="sm" block />
              </div>
            </div>
          </div>
        </aside>

        <!-- Form -->
        <div class="lg:col-span-7" data-reveal data-reveal-delay="0.1">
          <div class="rounded-lg border border-hairline bg-canvas p-6 md:p-8">
            <h2 class="display-md text-ink">Send a message</h2>
            <p class="body mt-3 text-ink">
              The more you tell us about your competitors and current rankings, the
              more useful the first reply will be.
            </p>

            <form
              id="contact-form"
              class="mt-8 grid gap-5 sm:grid-cols-2"
              method="post"
              action={forms.contactEndpoint ?? '/api/contact'}
              novalidate
            >
              <!-- Honeypot: hidden from humans, catches bots. -->
              <div class="hidden" aria-hidden="true">
                <label>Company
                  <input type="text" name="company" tabindex="-1" autocomplete="off" />
                </label>
              </div>
              <div>
                <label for="c-name" class="label block text-ink">
                  Your name<span class="text-destructive" aria-hidden="true"> *</span>
                </label>
                <input id="c-name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe" class={inputClass} />
                <p class="caption mt-1.5 hidden text-destructive" data-error-for="c-name" role="alert"></p>
              </div>

              <div>
                <label for="c-email" class="label block text-ink">
                  Email<span class="text-destructive" aria-hidden="true"> *</span>
                </label>
                <input id="c-email" name="email" type="email" required autocomplete="email" inputmode="email" spellcheck="false" autocapitalize="none" placeholder="jane@company.com" class={inputClass} />
                <p class="caption mt-1.5 hidden text-destructive" data-error-for="c-email" role="alert"></p>
              </div>

              <div>
                <label for="c-phone" class="label block text-ink">Phone</label>
                <input id="c-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(555) 000-0000" class={inputClass} />
              </div>

              <div>
                <label for="c-website" class="label block text-ink">
                  Website<span class="text-destructive" aria-hidden="true"> *</span>
                </label>
                <input id="c-website" name="website" type="text" required autocomplete="url" spellcheck="false" autocapitalize="none" placeholder="company.com" class={inputClass} />
                <p class="caption mt-1.5 hidden text-destructive" data-error-for="c-website" role="alert"></p>
              </div>

              <div>
                <label for="c-service" class="label block text-ink">What you need</label>
                <select id="c-service" name="service" class={`${inputClass} select-field`}>
                  {services.map((s) => <option value={s.value}>{s.label}</option>)}
                </select>
              </div>

              <div>
                <label for="c-location" class="label block text-ink">
                  Target city<span class="text-destructive" aria-hidden="true"> *</span>
                </label>
                <input id="c-location" name="location" type="text" required autocomplete="address-level2" placeholder="Dallas, TX" class={inputClass} />
                <p class="caption mt-1.5 hidden text-destructive" data-error-for="c-location" role="alert"></p>
              </div>

              <div class="sm:col-span-2">
                <label for="c-message" class="label block text-ink">
                  How can we help?<span class="text-destructive" aria-hidden="true"> *</span>
                </label>
                <textarea
                  id="c-message"
                  name="message"
                  rows="5"
                  required
                  placeholder="Where you rank now, who is beating you, what you want to change."
                  class={inputClass}></textarea>
                <p class="caption mt-1.5 hidden text-destructive" data-error-for="c-message" role="alert"></p>
              </div>

              <div class="sm:col-span-2">
                <Button type="submit" size="lg" block>Send message</Button>
              </div>
            </form>

            <div
              id="contact-success"
              class="hidden rounded-md border border-hairline bg-block-mint p-5"
              role="status"
              tabindex="-1"
            >
              <p class="label text-ink" data-success-title>Message sent — thank you.</p>
              <p class="body-sm mt-1.5 text-ink" data-success-body>
                It reached Omar directly. Expect a reply within four business hours.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ inbox: contact.email }}>
  const form = document.querySelector('#contact-form');
  const success = document.querySelector('#contact-success');

  function slotFor(field) {
    return document.querySelector(`[data-error-for="${field.id}"]`);
  }

  function showError(field, message) {
    const slot = slotFor(field);
    field.setAttribute('aria-invalid', 'true');
    if (slot) {
      slot.textContent = message;
      slot.classList.remove('hidden');
    }
  }

  function clearError(field) {
    const slot = slotFor(field);
    field.removeAttribute('aria-invalid');
    if (slot) {
      slot.textContent = '';
      slot.classList.add('hidden');
    }
  }

  if (form && success) {
    const fields = Array.from(form.querySelectorAll('input, textarea')).filter(
      (f) => f.required
    );

    for (const field of fields) {
      field.addEventListener('input', () => {
        if (field.validity.valid) clearError(field);
      });
    }

    form.addEventListener('submit', (event) => {
      let firstInvalid = null;

      for (const field of fields) {
        if (!field.value.trim()) {
          showError(field, 'This one is required.');
          firstInvalid = firstInvalid || field;
        } else if (!field.validity.valid) {
          showError(
            field,
            field.type === 'email' ? 'Check the email address.' : 'Check this value.'
          );
          firstInvalid = firstInvalid || field;
        } else {
          clearError(field);
        }
      }

      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
        return;
      }

      // Always handle the submit with fetch so we can show inline feedback and
      // fall back to a mailto draft if the endpoint is missing or errors.
      event.preventDefault();

      const data = new FormData(form);
      const action = form.getAttribute('action');
      const submitBtn = form.querySelector('button[type="submit"], [type="submit"]');

      const openMailFallback = () => {
        const body = [
          `Name: ${data.get('name')}`,
          `Email: ${data.get('email')}`,
          `Phone: ${data.get('phone') || '—'}`,
          `Website: ${data.get('website')}`,
          `Target city: ${data.get('location')}`,
          `Interested in: ${data.get('service')}`,
          '',
          data.get('message'),
        ].join('\n');

        window.location.href =
          `mailto:${inbox}` +
          `?subject=${encodeURIComponent('Enquiry from ' + data.get('website'))}` +
          `&body=${encodeURIComponent(body)}`;

        const heading = success.querySelector('[data-success-title]');
        const detail = success.querySelector('[data-success-body]');
        if (heading) heading.textContent = 'Your email draft is open.';
        if (detail)
          detail.innerHTML =
            'Send it and Omar will reply within four business hours. If nothing ' +
            `opened, write to <a href="mailto:${inbox}" class="font-medium underline underline-offset-4">${inbox}</a>.`;

        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.focus();
      };

      const showSent = () => {
        const heading = success.querySelector('[data-success-title]');
        const detail = success.querySelector('[data-success-body]');
        if (heading) heading.textContent = 'Message sent — thank you.';
        if (detail)
          detail.textContent =
            'It reached Omar directly. Expect a reply within four business hours.';
        form.classList.add('hidden');
        success.classList.remove('hidden');
        success.focus();
      };

      if (!action) {
        openMailFallback();
        return;
      }

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.setAttribute('aria-busy', 'true');
      }

      fetch(action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      })
        .then((res) => {
          if (res.ok) {
            showSent();
          } else {
            // Endpoint not configured or delivery failed — never drop the lead.
            openMailFallback();
          }
        })
        .catch(() => openMailFallback())
        .finally(() => {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('aria-busy');
          }
        });
    });
  }
</script>
