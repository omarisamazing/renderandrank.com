---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import CalScript from '../components/CalScript.astro';
import FloatingCalButton from '../components/FloatingCalButton.astro';
import Toast from '../components/Toast.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { siteConfig, localeMeta, canonicalUrlFor, localizedPath, LOCALIZED_ROUTES, STAGING_HOST_SUFFIX } from '../config/site';
import type { SiteLocale } from '../config/site';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import '../styles/global.css';

// Inter Variable, subset to latin + latin-ext only (the site's i18n is en + de,
// so cyrillic / greek / vietnamese are never needed). Importing the two woff2
// assets with `?url` makes Vite emit exactly those files and gives us the final
// hashed URLs to reference from the @font-face rules below — the all-subsets
// `@fontsource-variable/inter` CSS import (which bundled all six subsets) is
// gone. The "Inter Variable" family and 100–900 weight range are unchanged.
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExtWoff2 from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';

const interFontFaceCss = `
@font-face {
  font-family: "Inter Variable";
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url("${interLatinExtWoff2}") format("woff2-variations");
  unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
  font-family: "Inter Variable";
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url("${interLatinWoff2}") format("woff2-variations");
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
`;

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  keywords?: string;
  /** The booking page hides the floating prompt — the calendar is already there. */
  showBookingPrompt?: boolean;
  /** Load the Cal.com embed (script + preconnect). True ONLY on /book-a-call —
      every other page links there as a plain navigation, so the third-party
      chain stays off their critical path entirely. */
  loadCal?: boolean;
  /** Legal and other non-indexable pages set this to emit a robots noindex tag. */
  noindex?: boolean;
  /** Article pages pass ogType 'article' plus publish/modify dates. */
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
}

const {
  title = `${siteConfig.name} | Local SEO, AEO & Generative Search Engineering`,
  description = siteConfig.description,
  canonical: canonicalProp,
  image = "/og-cover.jpg",
  keywords = 'local SEO, Google Maps 3-pack, AEO, generative engine optimization, GEO, AI search visibility, ChatGPT SEO, Google Business Profile, citation building, local search engineering',
  showBookingPrompt = true,
  loadCal = false,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
} = Astro.props;

// ---- Locale / hreflang core (multilingual USA/Europe) ----
const lang = getLangFromUrl(Astro.url) as SiteLocale;
const t = useTranslations(lang);
const { htmlLang, ogLocale } = localeMeta[lang] ?? localeMeta.en;

// Strip a leading /{locale}/ prefix so alternates stay in sync.
const localeCodes = Object.keys(localeMeta);
const firstSeg = Astro.url.pathname.split('/')[1] ?? '';
const unprefixedPath = localeCodes.includes(firstSeg) && firstSeg !== 'en'
  ? Astro.url.pathname.slice(firstSeg.length + 1) || '/'
  : Astro.url.pathname;

// Canonical always targets the root production domain (never *.pages.dev).
const canonical = canonicalProp ?? canonicalUrlFor(Astro.url.pathname);
// Full hreflang cluster only where every alternate resolves (see
// LOCALIZED_ROUTES); elsewhere a self-referential tag until wrappers land.
const normalizedUnprefixed =
  unprefixedPath !== '/' ? unprefixedPath.replace(/\/$/, '') || '/' : '/';
const hasFullCluster = (LOCALIZED_ROUTES as string[]).includes(normalizedUnprefixed);
// Staging safety net: any build served from a *.pages.dev host (preview or
// the temporary subdomain) is de-indexed at build time via meta robots.
// Production on the root domain stays indexable. Shifting staging → root
// later needs no code change — just point PUBLIC_SITE_URL at the domain.
const isStagingHost =
  Astro.url.hostname.endsWith(STAGING_HOST_SUFFIX) ||
  canonical.includes(STAGING_HOST_SUFFIX);
const alternates = (Object.keys(localeMeta) as SiteLocale[]).map((code) => ({
  hreflang: localeMeta[code].hreflang,
  href: canonicalUrlFor(localizedPath(unprefixedPath, code)),
}));
const xDefaultHref = canonicalUrlFor(localizedPath(unprefixedPath, 'en'));
const ogAlternates = (Object.keys(localeMeta) as SiteLocale[]).filter(
  (code) => code !== lang,
);

const sameAs = Object.values(siteConfig.socials).filter(Boolean);

// LocalBusiness + WebSite in one @graph — the primary entity for both Google
// rich results and AI answer-engine citation.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${siteConfig.url}/#business`,
      name: siteConfig.name,
      url: siteConfig.url,
      logo: `${siteConfig.url}/Wordmark black.svg`,
      image: new URL(image, siteConfig.url).href,
      description: siteConfig.description,
      slogan: siteConfig.tagline,
      telephone: siteConfig.contact.phone,
      email: siteConfig.contact.email,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Dhaka',
        addressCountry: 'BD',
      },
      areaServed: [
        { '@type': 'Country', name: 'United States' },
        { '@type': 'Country', name: 'GB' },
        { '@type': 'Country', name: 'DE' },
        { '@type': 'Country', name: 'FR' },
        { '@type': 'Place', name: 'Europe' },
      ],
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '09:00',
          closes: '18:00',
        },
      ],
      founder: {
        '@type': 'Person',
        name: siteConfig.founder.name,
        jobTitle: siteConfig.founder.role,
      },
      sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.url}/#website`,
      url: siteConfig.url,
      name: siteConfig.name,
      description: siteConfig.description,
      inLanguage: htmlLang,
      publisher: { '@id': `${siteConfig.url}/#business` },
    },
  ],
};

const socialImage = new URL(image, siteConfig.url).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />

    {loadCal && <link rel="preconnect" href="https://app.cal.com" />}

    <!-- Favicons & manifest -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Render & Rank" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- The wordmark face renders above the fold in the nav, so preload it -->
    <link
      rel="preload"
      href="/fonts/fuuld.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    {hasFullCluster ? (
      <>
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
      </>
    ) : (
      <link rel="alternate" hreflang={localeMeta[lang].hreflang} href={canonical} />
    )}
    <meta name="generator" content={Astro.generator} />

    {(noindex || isStagingHost) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternates.map((code) => (
      <meta property="og:locale:alternate" content={localeMeta[code].ogLocale} />
    ))}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Blog`} href="/rss.xml" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Inter Variable @font-face — latin + latin-ext subsets only. -->
    <style is:inline set:html={interFontFaceCss}></style>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <Motion />
    {loadCal && <CalScript />}
  </head>

  <body class="bg-canvas text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-4 focus-visible:left-4 focus-visible:z-100 focus-visible:rounded-pill focus-visible:bg-ink focus-visible:px-5 focus-visible:py-3 focus-visible:text-canvas focus-visible:label"
    >
      {t('a11y.skipToContent')}
    </a>

    <Navbar />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
    {showBookingPrompt && <FloatingCalButton />}
    <ChatWidget />
    <Toast />
  </body>
</html>
