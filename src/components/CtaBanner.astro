---
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import BookCallButton from './BookCallButton.astro';
import { Check } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;

const guarantees = [t('cta.g1'), t('cta.g2'), t('cta.g3')];
---

<!--
  Navy, not pure black. DESIGN.md reserves `color-block-navy` for the one dark
  surface above the footer, which is exactly this slot — and it keeps the closing
  CTA from being the fourth near-black surface on the home page (the marquee
  strip, the comparison card and the ROI result card are the others).
-->
<Section>
  <div
    class="color-block color-block-navy color-block--bleed text-center on-inverse md:px-12 md:py-20"
    data-reveal-group
  >
    <div class="mx-auto max-w-2xl">
      <Eyebrow tone="inverse" data-reveal>{t('blog.post.ctaEyebrow')}</Eyebrow>

      <h2 class="display-lg mt-5 text-inverse-ink" data-reveal>
        {t('cta.title')}
      </h2>

      <p class="body-lg mt-6 text-inverse-ink" data-reveal>
        {t('cta.sub')}
      </p>

      <div
        class="mt-9 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center"
        data-reveal
      >
        <BookCallButton variant="inverse" size="lg" label={t('hero.cta.book')} />
        <Button href={`${prefix}/contact`} variant="inverseGhost" size="lg">
          {t('cta.audit')}
        </Button>
      </div>

      <ul
        class="mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 border-t border-white/15 pt-8"
        data-reveal
      >
        {
          guarantees.map((item) => (
            <li class="flex items-center gap-2">
              <Check class="size-4 shrink-0 text-block-lime" aria-hidden="true" />
              <span class="caption text-inverse-ink">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
