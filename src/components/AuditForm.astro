---
/**
 * Free-audit intake. Lives on the lime colour block, which DESIGN.md assigns to
 * contact forms. Moved out of the hero so the hero can stay a headline, a
 * paragraph and two pills.
 *
 * Posts to Formspree-style endpoints via `siteConfig.forms.auditEndpoint`; when
 * that is unset it degrades to a mailto link so the form is never a dead end.
 */
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import { siteConfig } from '../config/site';
import { Check, CircleCheck, Clock, Lock } from '@lucide/astro';

const fields = [
  { id: 'name', label: 'Your name', type: 'text', placeholder: 'Sarah Jenkins', span: 2, maxlength: 100 },
  { id: 'email', label: 'Email', type: 'email', placeholder: 'sarah@business.com', span: 1, maxlength: 254 },
  { id: 'phone', label: 'Phone', type: 'tel', placeholder: '(512) 555-0199', span: 1, maxlength: 20 },
  { id: 'website', label: 'Website', type: 'text', placeholder: 'company.com', span: 1, maxlength: 200 },
  { id: 'location', label: 'City and state', type: 'text', placeholder: 'City, Country (e.g. London, UK)', span: 1, maxlength: 120 },
] as const;

// Optional Cloudflare Turnstile. Renders only when a public site key is set.
const turnstileSiteKey = siteConfig.turnstileSiteKey;

const included = [
  'Live geo-grid rank across your service radius',
  'Which answer engines currently name you',
  'The three fixes with the largest effect',
];

// Reuses the same Cloudflare Pages Function as the contact form. Falls back to
// a mailto draft if the endpoint is unreachable so the form is never a dead end.
const endpoint = siteConfig.forms.contactEndpoint ?? '/api/contact';
---

<Section id="free-audit">
  <div class="color-block color-block-lime color-block--bleed">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Pitch -->
      <div class="lg:col-span-5" data-reveal-group>
        <Eyebrow tone="on-block" data-reveal>Free audit</Eyebrow>

        <h2 class="display-md mt-4 text-ink" data-reveal>
          See where you actually rank, in 24 hours
        </h2>

        <p class="body mt-5 text-ink" data-reveal>
          Send five details. Omar pulls your live geo-grid, queries the answer
          engines for your category, and emails the report back. No call required,
          no pitch attached.
        </p>

        <ul class="mt-8 flex flex-col gap-3" data-reveal>
          {
            included.map((item) => (
              <li class="flex gap-2.5">
                <Check class="mt-0.5 size-4 shrink-0 text-success" aria-hidden="true" />
                <span class="body-sm text-ink">{item}</span>
              </li>
            ))
          }
        </ul>

        <p class="caption mt-8 inline-flex items-center gap-2 text-ink" data-reveal>
          <Clock class="size-4 shrink-0" aria-hidden="true" />
          Turnaround is one business day.
        </p>
      </div>

      <!-- Form -->
      <div class="lg:col-span-7" data-reveal data-reveal-delay="0.1">
        <div class="rounded-lg border border-black/8 bg-canvas p-6 md:p-8">
          <form
            id="audit-form"
            class="grid gap-5 sm:grid-cols-2"
            method="post"
            action={endpoint ?? undefined}
            novalidate
          >
            <!-- The endpoint expects a message; the audit request carries a fixed one. -->
            <input
              type="hidden"
              name="message"
              value="Free geo-grid and AI visibility audit request."
            />
            <input type="hidden" name="service" value="audit" />
            <!-- Honeypot: hidden from humans, catches bots. -->
            <div class="hidden" aria-hidden="true">
              <label>Company
                <input type="text" name="company" tabindex="-1" autocomplete="off" />
              </label>
            </div>
            {
              fields.map((field) => (
                <div class:list={[field.span === 2 && 'sm:col-span-2']}>
                  <label for={`audit-${field.id}`} class="label block text-ink">
                    {field.label}
                    <span class="text-destructive" aria-hidden="true"> *</span>
                  </label>
                  <input
                    id={`audit-${field.id}`}
                    name={field.id}
                    type={field.type}
                    required
                    autocomplete={
                      field.id === 'name'
                        ? 'name'
                        : field.id === 'email'
                          ? 'email'
                          : field.id === 'phone'
                            ? 'tel'
                            : field.id === 'website'
                              ? 'url'
                              : 'address-level2'
                    }
                    inputmode={
                      field.id === 'email' ? 'email' : field.id === 'phone' ? 'tel' : undefined
                    }
                    spellcheck={field.id === 'email' || field.id === 'website' ? 'false' : undefined}
                    autocapitalize={
                      field.id === 'email' || field.id === 'website' ? 'none' : undefined
                    }
                    placeholder={field.placeholder}
                    maxlength={field.maxlength}
                    class="mt-2 h-12 w-full rounded-md border border-hairline bg-canvas px-3.5 text-[1.0625rem] text-ink placeholder:text-muted-foreground focus-visible:border-ink focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-ink"
                  />
                  <p
                    class="caption mt-1.5 hidden text-destructive"
                    data-error-for={`audit-${field.id}`}
                    role="alert"
                  >
                  </p>
                </div>
              ))
            }

            {
              turnstileSiteKey && (
                <div class="cf-turnstile sm:col-span-2" data-sitekey={turnstileSiteKey} />
              )
            }

            <div class="sm:col-span-2">
              <Button type="submit" size="lg" block>Send me the audit</Button>
            </div>

            <p class="caption sm:col-span-2 inline-flex items-center justify-center gap-2 text-ink">
              <Lock class="size-3.5 shrink-0" aria-hidden="true" />
              Your details go to Omar directly. No list, no sequence.
            </p>
          </form>

          <div
            id="audit-success"
            class="hidden rounded-lg border border-black/8 bg-block-mint p-6"
            role="status"
            tabindex="-1"
          >
            <div class="flex gap-3.5">
              <CircleCheck class="mt-0.5 size-5 shrink-0 text-success" aria-hidden="true" />
              <div>
                <p class="card-title text-ink" data-success-title>Audit request received.</p>
                <p class="body-sm mt-1.5 text-ink" data-success-body>
                  Omar pulls your geo-grid and emails the report within one business day.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script is:inline define:vars={{ inbox: siteConfig.contact.email }}>
  const form = document.querySelector('#audit-form');
  const success = document.querySelector('#audit-success');

  function slotFor(input) {
    return document.querySelector(`[data-error-for="${input.id}"]`);
  }

  function showError(input, message) {
    const slot = slotFor(input);
    input.setAttribute('aria-invalid', 'true');
    if (slot) {
      slot.textContent = message;
      slot.classList.remove('hidden');
    }
  }

  function clearError(input) {
    const slot = slotFor(input);
    input.removeAttribute('aria-invalid');
    if (slot) {
      slot.textContent = '';
      slot.classList.add('hidden');
    }
  }

  if (form && success) {
    // Validation rules — mirrored on the server in functions/api/contact.ts.
    const RULES = {
      name: {
        test: (v) => /^\p{L}[\p{L}.'-]*(?:\s+\p{L}[\p{L}.'-]*)+$/u.test(v),
        msg: 'Enter your first and last name.',
      },
      email: {
        test: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v),
        msg: 'Enter a valid email, like name@company.com.',
      },
      phone: {
        test: (v) => {
          const d = v.replace(/\D/g, '');
          return d.length >= 7 && d.length <= 15;
        },
        msg: 'Enter a valid phone number with area code.',
      },
      website: {
        test: (v) => /^(https?:\/\/)?([\w-]+\.)+[a-z]{2,}(\/\S*)?$/i.test(v),
        msg: 'Enter a valid website, like company.com.',
      },
      location: { test: (v) => v.length >= 2, msg: 'Enter your city and state.' },
    };

    const inputs = Array.from(form.querySelectorAll('input')).filter(
      (f) => f.name && RULES[f.name]
    );

    function ruleMessage(input) {
      const rule = RULES[input.name];
      if (!rule) return null;
      const value = input.value.trim();
      if (!value) return rule.optional ? null : 'This one is required.';
      return rule.test(value) ? null : rule.msg;
    }

    for (const input of inputs) {
      input.addEventListener('input', () => {
        if (!ruleMessage(input)) clearError(input);
      });
    }

    form.addEventListener('submit', (event) => {
      let firstInvalid = null;

      for (const input of inputs) {
        const message = ruleMessage(input);
        if (message) {
          showError(input, message);
          firstInvalid = firstInvalid || input;
        } else {
          clearError(input);
        }
      }

      if (firstInvalid) {
        event.preventDefault();
        firstInvalid.focus();
        return;
      }

      // Handle with fetch so we can show inline feedback and fall back to a
      // mailto draft if the endpoint is missing or errors.
      event.preventDefault();

      const data = new FormData(form);
      const action = form.getAttribute('action');
      const submitBtn = form.querySelector('button[type="submit"], [type="submit"]');

      const openMailFallback = () => {
        const body = [
          `Name: ${data.get('name')}`,
          `Email: ${data.get('email')}`,
          `Phone: ${data.get('phone')}`,
          `Website: ${data.get('website')}`,
          `City: ${data.get('location')}`,
          '',
          'Please send my free geo-grid and AI visibility audit.',
        ].join('\n');

        window.location.href =
          `mailto:${inbox}` +
          `?subject=${encodeURIComponent('Free audit request — ' + data.get('website'))}` +
          `&body=${encodeURIComponent(body)}`;

        window.dispatchEvent(new CustomEvent('show-toast', { detail: { message: "Couldn't reach the server — we've opened your email app so you can send it directly.", type: 'error' } }));
      };

      const showSent = () => {
        window.dispatchEvent(new CustomEvent('show-toast', { detail: { message: "Request received! Your free geo-grid audit will land in your inbox within 1 business day.", type: 'success' } }));
        form.reset();
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.removeAttribute('aria-busy');
        }
      };

      if (!action) {
        openMailFallback();
        return;
      }

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.setAttribute('aria-busy', 'true');
      }

      fetch(action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      })
        .then((res) => {
          if (res.ok) showSent();
          else openMailFallback();
        })
        .catch(() => openMailFallback())
        .finally(() => {
          if (submitBtn) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('aria-busy');
          }
        });
    });
  }
</script>
