---
/**
 * Wordmark lockup. No symbol mark — the type *is* the mark, set in Fuuld
 * (public/fonts/fuuld.woff2).
 *
 * Reads "Render Rank" — no ampersand, which also keeps the whole lockup inside
 * Fuuld's trial cut (A–Z a–z 0–9 ! , - . ? only), so nothing falls back to
 * Inter mid-word. The word gap is set in em so it tracks every size step.
 */
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'display';
  variant?: 'inline' | 'stacked';
  tone?: 'ink' | 'inverse';
}

const {
  class: className = '',
  size = 'md',
  variant = 'inline',
  tone = 'ink',
} = Astro.props;

const sizes = {
  sm: 'text-[1.0625rem]',
  md: 'text-[1.3125rem]',
  lg: 'text-[1.625rem]',
  xl: 'text-[2.25rem]',
  display: 'text-[clamp(3.5rem,12vw,9rem)]',
} as const;

const toneClass = tone === 'inverse' ? 'text-inverse-ink' : 'text-ink';
---

{
  variant === 'stacked' ? (
    <span
      class:list={[
        'font-display block leading-[0.86] tracking-[-0.035em] lowercase',
        sizes[size],
        toneClass,
        className,
      ]}
      aria-label="Render and Rank"
      translate="no"
    >
      <span class="block" aria-hidden="true">Render</span>
      <span class="block" aria-hidden="true">Rank</span>
    </span>
  ) : (
    <span
      class:list={[
        'font-display inline-flex items-baseline gap-[0.22em] whitespace-nowrap leading-none tracking-[-0.02em]',
        sizes[size],
        toneClass,
        className,
      ]}
      aria-label="Render Rank"
      translate="no"
    >
      <span aria-hidden="true">Render</span>
      <span aria-hidden="true">Rank</span>
    </span>
  )
}
