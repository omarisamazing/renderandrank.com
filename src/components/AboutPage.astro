---
/**
 * AboutPage — shared about body for `/about` and every locale wrapper
 * (`/es/about/` …). Hero + principles-section headers resolve via
 * `useTranslations` from the URL locale; principle cards, FounderSection,
 * TestimonialsSection and CtaBanner bodies stay English until phase 3
 * (tracked in docs/i18n.md).
 */
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import FounderSection from './FounderSection.astro';
import TestimonialsSection from './TestimonialsSection.astro';
import CtaBanner from './CtaBanner.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const principles = [
  {
    title: 'Code and data over adjectives',
    body: 'Search engines parse schema, entity relationships, citation consistency and geo-signals. They do not read positioning statements. So we build the parseable part properly and skip the rest.',
  },
  {
    title: 'The person you hire is the person who works',
    body: 'No coordinators relaying messages, no discovery call with a closer followed by delivery from someone else. Omar takes the call and does the work.',
  },
  {
    title: 'Calls are the only metric that pays a mortgage',
    body: 'Impressions and traffic are diagnostics, not results. We report on calls, booked estimates and closed revenue, and judge the engagement on those.',
  },
];
---

<div class="border-b border-hairline bg-canvas py-16 md:py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <Eyebrow data-reveal>{t('about.hero.eyebrow')}</Eyebrow>
      <h1 class="display-lg mt-4 text-ink" data-reveal>
        {t('about.hero.title')}
      </h1>
      <p class="subhead mt-5 text-ink" data-reveal>
        {t('about.hero.sub')}
      </p>
    </div>
  </div>
</div>

<FounderSection />

<Section divider>
  <div class="mx-auto max-w-2xl text-center" data-reveal-group>
    <Eyebrow data-reveal>{t('about.principles.eyebrow')}</Eyebrow>
    <h2 class="display-md mt-4 text-ink" data-reveal>{t('about.principles.title')}</h2>
  </div>

  <div class="mx-auto mt-12 grid max-w-5xl gap-6 md:mt-16 md:grid-cols-3" data-reveal-group>
    {
      principles.map((item, i) => (
        <div class="rounded-lg border border-hairline bg-canvas p-6 md:p-7" data-reveal>
          <span
            class="numeric flex size-10 items-center justify-center rounded-full bg-surface-soft text-[0.9375rem] font-medium text-ink"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <h3 class="card-title mt-5 text-ink">{item.title}</h3>
          <p class="body-sm mt-3 text-ink">{item.body}</p>
        </div>
      ))
    }
  </div>
</Section>

<TestimonialsSection />
<CtaBanner />
