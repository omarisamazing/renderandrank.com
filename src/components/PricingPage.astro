---
/**
 * PricingPage — shared pricing body for `/pricing` and every locale wrapper
 * (`/es/pricing/` …). Page-hero strings resolve via `useTranslations` and the
 * comparison matrix + onboarding timeline via `pricingDict` from the URL
 * locale (EN mirrors the original inline data verbatim). Tier names and
 * prices stay product facts.
 */
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import PricingSection from './PricingSection.astro';
import FaqSection from './FaqSection.astro';
import CtaBanner from './CtaBanner.astro';
import { Check, Minus } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { pricingDict } from '../i18n/pricingDict';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const copy = pricingDict[lang] ?? pricingDict.en;

const tiers = ['Growth Core', 'Lead Machine', 'Market Dominator'];
const prices = ['$149', '$249', '$349'];

const matrix = copy.matrix;
---

<div class="border-b border-hairline bg-canvas py-16 md:py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <Eyebrow data-reveal>{t('pricing.hero.eyebrow')}</Eyebrow>
      <h1 class="display-lg mt-4 text-ink" data-reveal>
        {t('pricing.hero.title')}
      </h1>
      <p class="subhead mt-5 text-ink" data-reveal>
        {t('pricing.hero.sub')}
      </p>
    </div>
  </div>
</div>

<PricingSection showHeader={false} />

<!-- Retainer comparison -->
<Section divider>
  <div class="mx-auto max-w-2xl text-center" data-reveal-group>
    <Eyebrow data-reveal>{copy.matrixEyebrow}</Eyebrow>
    <h2 class="display-md mt-4 text-ink" data-reveal>{copy.matrixTitle}</h2>
  </div>

  <div class="mx-auto mt-12 max-w-4xl overflow-x-auto" data-reveal>
    <table class="w-full min-w-3xl border-collapse text-left">
      <caption class="sr-only">{copy.matrixCaption}</caption>
      <thead>
        <tr class="border-b border-hairline">
          <th scope="col" class="eyebrow px-4 pb-4 text-ink">{copy.matrixCol}</th>
          {
            tiers.map((tier, i) => (
              <th scope="col" class="px-4 pb-4 text-center">
                <span class="label block text-ink">{tier}</span>
                <span class="caption numeric mt-0.5 block text-ink">
                  {prices[i]}/mo
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          matrix.map((row) => (
            <tr class="border-b border-hairline-soft last:border-b-0">
              <th scope="row" class="body-sm px-4 py-4 font-medium text-ink">
                {row.label}
              </th>
              {row.values.map((value) => (
                <td class="body-sm px-4 py-4 text-center text-ink">
                  {value === true ? (
                    <>
                      <Check
                        class="mx-auto size-4 text-success"
                        aria-hidden="true"
                      />
                      <span class="sr-only">{copy.srIncluded}</span>
                    </>
                  ) : value === false ? (
                    <>
                      <Minus class="mx-auto size-4 text-ink" aria-hidden="true" />
                      <span class="sr-only">{copy.srNotIncluded}</span>
                    </>
                  ) : (
                    value
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Section>

<!-- What happens after you start timeline -->
<Section divider>
  <div class="mx-auto max-w-2xl text-center" data-reveal-group>
    <Eyebrow data-reveal>{copy.timelineEyebrow}</Eyebrow>
    <h2 class="display-md mt-4 text-ink" data-reveal>{copy.timelineTitle}</h2>
    <p class="subhead mt-4 text-ink" data-reveal>
      {copy.timelineSub}
    </p>
  </div>

  <div class="mx-auto mt-12 grid max-w-4xl gap-6 md:grid-cols-3" data-reveal-group>
    {copy.timeline.map((step) => (
      <div class="rounded-lg border border-hairline bg-canvas p-6 flex flex-col justify-between" data-reveal>
        <div>
          <span class="numeric flex size-9 items-center justify-center rounded-full bg-surface-soft text-[0.9375rem] font-medium text-ink">{step.n}</span>
          <h3 class="card-title mt-4 text-ink">{step.title}</h3>
          <p class="body-sm mt-2.5 text-ink">{step.body}</p>
        </div>
        <p class="caption text-ink/60 mt-6 pt-4 border-t border-hairline">{step.foot}</p>
      </div>
    ))}
  </div>
</Section>

<FaqSection />
<CtaBanner />
