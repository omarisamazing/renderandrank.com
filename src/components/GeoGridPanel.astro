---
/**
 * Geo-grid panel — the hero's product mock. A flat composition on the off-white
 * tile ground, no gradients or drop shadows (DESIGN.md: colour and confident
 * type do the work that elevation usually does).
 *
 * The grid is a hardcoded rank pattern rather than randomised so the build is
 * reproducible and the composition never lands on an ugly arrangement.
 */
import Eyebrow from './ui/Eyebrow.astro';
import { MapPin } from '@lucide/astro';

// Rank at each sample point of a 9x7 grid, read left-to-right, top-to-bottom.
// Lower is better; 0 means "not in the top 20".
const ranks = [
  0, 0, 12, 9, 8, 11, 14, 0, 0,
  0, 11, 7, 5, 4, 6, 9, 13, 0,
  9, 6, 4, 2, 2, 3, 5, 8, 12,
  7, 4, 2, 1, 1, 1, 3, 6, 10,
  8, 5, 3, 1, 1, 2, 4, 7, 11,
  0, 8, 5, 3, 2, 4, 6, 10, 0,
  0, 0, 9, 6, 5, 7, 11, 0, 0,
];

const centre = 3 * 9 + 4; // the pin sits at the middle of row four

const band = (rank: number) => {
  if (rank === 0) return 'empty';
  if (rank <= 3) return 'top';
  if (rank <= 10) return 'mid';
  return 'low';
};

const bandClass = {
  top: 'bg-ink',
  mid: 'bg-block-lime border border-black/10',
  low: 'bg-canvas border border-hairline',
  empty: 'bg-transparent border border-dashed border-hairline',
} as const;

const legend = [
  { swatch: 'bg-ink', label: 'Top 3 — in the pack' },
  { swatch: 'bg-block-lime border border-black/10', label: 'Rank 4–10' },
  { swatch: 'bg-canvas border border-hairline', label: 'Rank 11+' },
];

const coverage = [
  { label: 'Grid points in the top 3', value: '31 of 63' },
  { label: 'Average rank', value: '4.2' },
  { label: 'Radius audited', value: '4.5 mi' },
];
---

<div
  class="mx-auto max-w-5xl overflow-hidden rounded-xl border border-hairline bg-surface-soft"
>
  <!-- Panel header -->
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-4 md:px-7"
  >
    <div class="flex items-center gap-2.5">
      <MapPin class="size-4 text-ink" aria-hidden="true" />
      <Eyebrow>Geo-grid audit &middot; Austin, TX</Eyebrow>
    </div>
    <span class="caption text-ink">"emergency plumber near me"</span>
  </div>

  <div class="grid gap-8 p-5 md:grid-cols-5 md:gap-10 md:p-8">
    <!-- The grid itself -->
    <div class="md:col-span-3">
      <div
        class="relative mx-auto grid aspect-9/7 w-full max-w-lg grid-cols-9 gap-1.5 sm:gap-2"
        role="img"
        aria-label="Geo-grid showing rank position across 63 sample points around the business. 31 points rank in the top three."
      >
        {
          ranks.map((rank, i) =>
            i === centre ? (
              <div class="relative flex items-center justify-center">
                <span
                  class="flex size-full items-center justify-center rounded-full bg-ink text-canvas"
                >
                  <MapPin class="size-3 sm:size-3.5" aria-hidden="true" />
                </span>
              </div>
            ) : (
              <div
                class:list={['rounded-full', bandClass[band(rank)]]}
                aria-hidden="true"
              />
            )
          )
        }
      </div>

      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {
          legend.map((item) => (
            <li class="flex items-center gap-2">
              <span class:list={['size-2.5 rounded-full', item.swatch]} aria-hidden="true" />
              <span class="caption text-ink">{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Readout -->
    <dl class="flex flex-col justify-center gap-5 md:col-span-2">
      {
        coverage.map((row) => (
          <div class="rounded-md border border-hairline bg-canvas p-4">
            <dt class="caption text-ink">{row.label}</dt>
            <dd class="stat numeric mt-1.5 text-ink">{row.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
