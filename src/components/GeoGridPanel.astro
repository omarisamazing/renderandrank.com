---
/**
 * Geo-grid panel — the hero's product mock. A flat composition on the off-white
 * tile ground, no gradients or drop shadows (DESIGN.md: colour and confident
 * type do the work that elevation usually does).
 *
 * The grid is a hardcoded rank pattern rather than randomised so the build is
 * reproducible and the composition never lands on an ugly arrangement.
 * Living details: numbered dots (Whitespark-style), center-out scan wave,
 * pin pulse, radius-ring draw, count-up readouts, a procedural street-map
 * etch behind the dots, a click-to-inspect point popup (MarkerPopup pattern:
 * category, rank + distance, audit date, CTA), a metric list with trend pills
 * (hexagon-card pattern, native count-up — no reaviz/react-countup), and a
 * Today / With-us before-after toggle that swaps rank data in place. All
 * motion is transform/opacity only and gated by prefers-reduced-motion.
 */
import Eyebrow from './ui/Eyebrow.astro';
import { MapPin, Star, Clock, Navigation, X, TrendingUp, TrendingDown } from '@lucide/astro';

// Rank at each sample point of a 9x7 grid, read left-to-right, top-to-bottom.
// Lower is better; 0 means "not in the top 20".
const ranks = [
  0, 0, 12, 9, 8, 11, 14, 0, 0,
  0, 11, 7, 5, 4, 6, 9, 13, 0,
  9, 6, 4, 2, 2, 3, 5, 8, 12,
  7, 4, 2, 1, 1, 1, 3, 6, 10,
  8, 5, 3, 1, 1, 2, 4, 7, 11,
  0, 8, 5, 3, 2, 4, 6, 10, 0,
  0, 0, 9, 6, 5, 7, 11, 0, 0,
];

// The "after" state — same footprint, tightened toward the pin. Coverage is
// derived with the same methodology as the before state (non-zero points,
// pin excluded): 50 of 63 in the top 3, 2.1 average.
const AFTER = [
  0, 4, 3, 2, 2, 2, 3, 4, 0,
  4, 3, 2, 1, 1, 1, 2, 3, 4,
  3, 2, 1, 1, 1, 1, 1, 2, 3,
  2, 1, 1, 1, 1, 1, 1, 1, 2,
  3, 2, 1, 1, 1, 1, 1, 2, 3,
  4, 3, 2, 1, 1, 1, 2, 3, 4,
  0, 4, 3, 2, 2, 2, 3, 4, 0,
];

const centre = 3 * 9 + 4; // the pin sits at the middle of row four
const centreCol = 4;
const centreRow = 3;

const band = (rank: number) => {
  if (rank === 0) return 'empty';
  if (rank <= 3) return 'top';
  if (rank <= 10) return 'mid';
  if (rank <= 12) return 'low';
  return 'risk';
};

const bandClass = {
  top: 'bg-ink text-canvas',
  mid: 'bg-block-lime border border-black/10 text-ink',
  low: 'bg-hairline text-ink',
  risk: 'bg-block-coral border border-black/10 text-ink',
  empty: 'bg-transparent border border-dashed border-hairline',
} as const;

const legend = [
  { swatch: 'bg-ink', label: 'Top 3 — in the pack' },
  { swatch: 'bg-block-lime border border-black/10', label: 'Rank 4–10' },
  { swatch: 'bg-hairline', label: 'Rank 11–12' },
  { swatch: 'bg-block-coral border border-black/10', label: 'Rank 13+' },
];

const coverage = [
  { label: 'Grid points in the top 3', before: '13 of 63', after: '50 of 63', countTo: 13, decimals: 0, suffix: ' of 63' },
  { label: 'Average rank', before: '6.2', after: '2.1', countTo: 6.2, decimals: 1, suffix: '' },
  { label: 'Radius audited', before: '4.5 mi', after: '4.5 mi', countTo: null as number | null, decimals: 0, suffix: '' },
];

// Metric list (hexagon-card pattern, native): each row swaps with the
// Today / With-us toggle via data-before / data-after, same as the readouts.
const metrics = [
  { id: 'top3', label: 'Points in the top 3', before: '13', after: '50', delta: '+37 pts', good: true },
  { id: 'mean', label: 'Mean rank in radius', before: '6.2', after: '2.1', delta: '−4.1 avg', good: true },
  { id: 'blind', label: 'Points outside top 20', before: '12', after: '4', delta: '−8 blind spots', good: true },
];

const ariaBefore =
  'Geo-grid showing rank position across 63 sample points around the business, surrounded by a 4.5 mile audit radius. 13 points rank in the top three.';
const ariaAfter =
  'Geo-grid showing rank position across 63 sample points around the business, surrounded by a 4.5 mile audit radius. 50 points rank in the top three.';

// Center-out scan wave: delay grows with Euclidean distance from the pin.
// 60ms per grid unit caps the far corners at ~0.35s — a scan, not a curtain.
const waveDelay = (i: number) => {
  const dx = (i % 9) - centreCol;
  const dy = Math.floor(i / 9) - centreRow;
  const dist = Math.sqrt(dx * dx + dy * dy);
  return `${(0.05 + dist * 0.06).toFixed(2)}s`;
};

// Approx miles from the business: the 4.5 mi ring sits at r = 2.5 grid units.
const tip = (i: number, rank: number) => {
  if (rank === 0) return 'Outside the top 20';
  const dx = (i % 9) - centreCol;
  const dy = Math.floor(i / 9) - centreRow;
  const mi = (Math.sqrt(dx * dx + dy * dy) * 1.8).toFixed(1);
  return `Rank ${rank} · ${mi} mi from business`;
};
---

  <div
  class="mx-auto max-w-5xl overflow-hidden rounded-xl border border-hairline bg-surface-soft"
  data-geo-panel
  data-geo-centre={centre}
>
  <!-- Panel header -->
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-hairline px-5 py-4 md:px-7"
  >
    <div class="flex items-center gap-2.5">
      <MapPin class="size-4 text-ink" aria-hidden="true" />
      <Eyebrow>Geo-grid audit &middot; Austin, TX</Eyebrow>
    </div>
    <div class="flex items-center gap-3">
      <span class="caption rounded-pill border border-hairline bg-canvas px-3 py-1 text-ink">&ldquo;emergency plumber near me&rdquo;</span>
      <span class="caption numeric hidden text-ink sm:inline">Jul 2025</span>
    </div>
  </div>

  <div class="grid gap-8 p-5 md:grid-cols-5 md:gap-10 md:p-8">
    <!-- The grid itself -->
    <div class="md:col-span-3">
      <!-- Before / after comparison toggle -->
      <div class="mb-5 flex justify-center" data-reveal data-reveal-delay="0.05s">
        <div
          role="group"
          aria-label="Compare the grid today versus with Render and Rank"
          class="inline-flex rounded-pill border border-hairline bg-canvas p-1"
        >
          <button
            type="button"
            data-geo-state="before"
            aria-pressed="true"
            class="caption rounded-pill bg-ink px-4 py-1.5 text-canvas transition-colors"
          >
            Today
          </button>
          <button
            type="button"
            data-geo-state="after"
            aria-pressed="false"
            class="caption rounded-pill px-4 py-1.5 text-ink transition-colors hover:bg-surface-soft"
          >
            With us
          </button>
        </div>
      </div>

      <div
        class="relative mx-auto w-full max-w-lg"
        role="img"
        aria-label={ariaBefore}
        data-geo-grid
        data-aria-before={ariaBefore}
        data-aria-after={ariaAfter}
      >
        <!-- Street-map etch + radius ring overlay (decorative, behind points).
             A procedural map — river, highway, arterials, side streets — drawn
             in ink at map-print opacity. No tile service, no keys, no extra
             requests; it ships as bytes inside this file. -->
        <svg
          class="pointer-events-none absolute inset-0 h-full w-full text-ink"
          viewBox="0 0 900 700"
          preserveAspectRatio="xMidYMid slice"
          aria-hidden="true"
        >
          <!-- Water / park masses -->
          <g fill="currentColor">
            <path
              d="M 640 -20 C 610 140 710 300 645 470 C 610 570 660 650 630 720 L 560 720 C 590 620 540 540 575 430 C 610 320 540 160 575 -20 Z"
              opacity="0.045"
            />
            <ellipse cx="150" cy="590" rx="120" ry="70" opacity="0.04" />
            <ellipse cx="810" cy="120" rx="90" ry="60" opacity="0.04" />
          </g>
          <!-- Highway + river road -->
          <g fill="none" stroke="currentColor" stroke-linecap="round">
            <path
              d="M -20 520 C 200 480 350 565 550 505 C 700 460 800 470 930 430"
              stroke-width="16"
              opacity="0.07"
            />
            <path
              d="M 640 -20 C 610 140 710 300 645 470 C 610 570 660 650 630 720"
              stroke-width="5"
              opacity="0.08"
            />
          </g>
          <!-- Arterials -->
          <g fill="none" stroke="currentColor" stroke-width="4" opacity="0.08">
            <path d="M -20 180 C 220 150 420 200 930 130" />
            <path d="M -20 360 C 250 340 500 390 930 330" />
            <path d="M 180 -20 C 200 220 160 480 210 720" />
            <path d="M 450 -20 C 430 200 470 460 440 720" />
            <path d="M 760 -20 C 780 220 740 480 790 720" />
            <ellipse cx="450" cy="350" rx="225" ry="175" />
          </g>
          <!-- Side streets -->
          <g fill="none" stroke="currentColor" stroke-width="2" opacity="0.07">
            <path d="M -20 80 C 300 60 600 95 930 70" />
            <path d="M -20 270 C 300 250 600 285 930 260" />
            <path d="M -20 450 C 300 430 600 465 930 440" />
            <path d="M -20 620 C 300 600 600 635 930 610" />
            <path d="M 90 -20 C 110 220 70 480 120 720" />
            <path d="M 315 -20 C 300 220 330 480 305 720" />
            <path d="M 585 -20 C 600 220 570 480 600 720" />
            <path d="M 850 -20 C 835 220 865 480 845 720" />
          </g>
          <!-- Neighborhood labels -->
          <g
            fill="currentColor"
            opacity="0.2"
            font-size="21"
            letter-spacing="5"
            text-anchor="middle"
          >
            <text x="450" y="120">DOWNTOWN</text>
            <text x="150" y="300" transform="rotate(-90 150 300)">OLD TOWN</text>
            <text x="730" y="620">HILLCREST</text>
          </g>
        </svg>
        <!-- Radius ring overlay (stretched to the grid box, behind points) -->
        <svg
          class="pointer-events-none absolute inset-0 h-full w-full"
          viewBox="0 0 9 7"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <!-- 4.5 mi audit radius ring (concentric, centred on the business pin) -->
          <circle
            data-geo-ring
            cx="4.5"
            cy="3.5"
            r="2.5"
            fill="none"
            class="text-ink/25"
            stroke="currentColor"
            stroke-width="0.03"
            stroke-dasharray="0.08 0.06"
            opacity="0.9"
            style="transform-box: fill-box; transform-origin: center;"
          />
        </svg>

        <!-- Grid points layer (above the overlay; in normal flow so every
             dot is a true square — aspect-square on the dot itself, never a
             stretched ellipse from the old absolute-fill approach).
             Dots are buttons that open the shared point popup below
             (MarkerPopup pattern); the pin carries a MarkerLabel. -->
        <div
          class="relative grid grid-cols-9 gap-1.5 sm:gap-2"
        >
          {
            ranks.map((rank, i) => {
              return i === centre ? (
                <div
                  class="relative flex aspect-square w-full flex-col items-center justify-center"
                  data-reveal
                  data-reveal-delay={waveDelay(i)}
                >
                  <span
                    data-geo-pulse
                    class="geo-pulse absolute inset-0 rounded-full bg-ink/20"
                    aria-hidden="true"
                  />
                  <span
                    class="relative flex size-full items-center justify-center rounded-full bg-ink text-canvas"
                  >
                    <MapPin class="size-3 sm:size-3.5" aria-hidden="true" />
                  </span>
                  <span class="caption absolute -bottom-5 rounded-pill border border-hairline bg-canvas px-2 py-px whitespace-nowrap text-ink">
                    Your business
                  </span>
                </div>
              ) : (
                <button
                  type="button"
                  class:list={[
                    'flex aspect-square w-full cursor-pointer items-center justify-center rounded-full transition-transform hover:scale-110 focus-visible:scale-110',
                    bandClass[band(rank)],
                  ]}
                  aria-label={tip(i, rank)}
                  data-reveal
                  data-reveal-delay={waveDelay(i)}
                  data-geo-dot={i}
                >
                  <span
                    data-geo-num
                    class:list={[
                      'text-[9px] leading-none font-semibold tabular-nums sm:text-[11px]',
                      rank === 0 && 'hidden',
                    ]}
                    aria-hidden="true"
                  >
                    {rank === 0 ? '' : rank}
                  </span>
                </button>
              );
            })
          }
        </div>

        <!-- Radius annotation callout (anchored near the ring's edge, with a
             canvas chip behind it so it never collides with the dots) -->
        <div
          class="pointer-events-none absolute top-[6%] right-[8%] flex items-center gap-1.5 rounded-pill border border-hairline bg-canvas px-2.5 py-1"
          data-reveal
          data-reveal-delay="0.5s"
        >
          <span class="caption numeric text-ink">4.5 mi</span>
          <span class="block h-px w-6 bg-ink/60" aria-hidden="true"></span>
        </div>
      </div>

      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {
          legend.map((item) => (
            <li class="flex items-center gap-2">
              <span class:list={['size-2.5 rounded-full', item.swatch]} aria-hidden="true" />
              <span class="caption text-ink">{item.label}</span>
            </li>
          ))
        }
        <li class="flex items-center gap-2">
          <svg
            class="size-3.5 text-hairline"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <circle
              cx="8"
              cy="8"
              r="6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-dasharray="1.6 1.2"
            />
          </svg>
          <span class="caption text-ink">Audit radius</span>
        </li>
      </ul>

      <!-- Point popup (MarkerPopup pattern, native): one shared card fed by
           the clicked dot. Flat canvas surface, no photo — a band swatch
           carries the rank colour so the hero stays fast (no Unsplash LCP).
           Hidden until a dot is picked; server renders the fallback copy. -->
      <div
        data-geo-popup
        hidden
        class="mx-auto mt-6 w-full max-w-md rounded-md border border-hairline bg-canvas p-4 text-left"
        role="status"
      >
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="caption text-ink" data-geo-popup-kw>&ldquo;emergency plumber near me&rdquo;</p>
            <h3 class="body-sm mt-1 font-semibold text-ink" data-geo-popup-title>Grid point · Rank 1 · 0.0 mi</h3>
          </div>
          <button
            type="button"
            data-geo-popup-close
            class="flex size-8 shrink-0 items-center justify-center rounded-full bg-surface-soft text-ink transition-transform hover:scale-105"
            aria-label="Close point details"
          >
            <X class="size-4" aria-hidden="true" />
          </button>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1.5">
          <span class="flex items-center gap-1.5 text-sm text-ink">
            <Star class="size-3.5 fill-ink text-ink" aria-hidden="true" />
            <span class="font-medium" data-geo-popup-rank>Rank 1</span>
            <span class="caption" data-geo-popup-band>Top 3 — in the pack</span>
          </span>
          <span class="flex items-center gap-1.5 text-sm text-ink">
            <Clock class="size-3.5" aria-hidden="true" />
            <span data-geo-popup-dist>0.0 mi from business · Jul 2025</span>
          </span>
        </div>
        <div class="mt-3 flex gap-2">
          <a
            href="#free-audit"
            class="caption inline-flex flex-1 items-center justify-center gap-1.5 rounded-pill bg-ink px-4 py-2 text-canvas"
          >
            <Navigation class="size-3.5" aria-hidden="true" />
            Get this coverage
          </a>
          <button
            type="button"
            data-geo-popup-close
            class="caption inline-flex items-center justify-center rounded-pill border border-hairline bg-canvas px-4 py-2 text-ink"
          >
            Keep exploring
          </button>
        </div>
      </div>
      <p class="caption mt-4 text-center text-ink" data-geo-hint>Tip: select any dot to inspect that block.</p>
    </div>

    <!-- Readout -->
    <div class="flex flex-col justify-center gap-5 md:col-span-2">
      <dl class="flex flex-col justify-center gap-5">
      {
        coverage.map((row) => (
          <div class="rounded-md border border-hairline bg-canvas p-4">
            <dt class="caption text-ink">{row.label}</dt>
            <dd
              class="stat numeric mt-1.5 text-ink"
              data-countup={row.countTo === null ? undefined : ''}
              data-count-to={row.countTo ?? undefined}
              data-decimals={row.decimals}
              data-suffix={row.suffix}
              data-before={row.before}
              data-after={row.after}
            >
              {row.before}
            </dd>
          </div>
        ))
      }
      </dl>

      <!-- Metric list (hexagon-card pattern, native): trend pills use
           DESIGN.md tokens — lime for gains, ink for the mark. -->
      <ul class="divide-y divide-hairline rounded-md border border-hairline bg-canvas">
        {
          metrics.map((m) => (
            <li class="flex items-center justify-between gap-3 p-4">
              <span class="body-sm text-ink">{m.label}</span>
              <span class="flex items-center gap-2">
                <span
                  class="stat numeric text-ink"
                  data-before={m.before}
                  data-after={m.after}
                >
                  {m.before}
                </span>
                <span class="caption inline-flex items-center gap-1 rounded-pill bg-block-lime px-2.5 py-1 text-ink">
                  {m.id === 'mean' || m.id === 'blind' ? (
                    <TrendingDown class="size-3.5" aria-hidden="true" />
                  ) : (
                    <TrendingUp class="size-3.5" aria-hidden="true" />
                  )}
                  {m.delta}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script type="application/json" data-geo-data set:html={JSON.stringify({ before: ranks, after: AFTER })} />

<script>
  import { animate, inView, stagger } from 'motion';

  const EASE = [0.22, 1, 0.36, 1] as const;

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Radius ring: gentle scale-in the first time the panel enters view.
    // Opacity + transform only, so this stays on WAAPI off the main thread.
    const ring = document.querySelector<SVGCircleElement>('[data-geo-ring]');
    const panel = document.querySelector<HTMLElement>('[data-geo-panel]');
    if (ring && panel) {
      let ringDone = false;
      inView(
        panel,
        () => {
          if (ringDone) return;
          ringDone = true;
          ring.style.willChange = 'opacity, transform';
          animate(
            ring,
            { opacity: [0, 0.9], transform: ['scale(0.92)', 'scale(1)'] },
            { duration: 1.1, ease: EASE }
          ).then(() => {
            ring.style.willChange = 'auto';
            ring.style.opacity = '';
            ring.style.transform = '';
          });
        },
        { amount: 0.35 }
      );
    }

    // Readout count-up: 13 → "13 of 63", 6.2 average. Static text is the
    // server-rendered fallback, so a JS failure still shows correct values.
    document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
      const target = Number(el.dataset.countTo);
      if (!Number.isFinite(target)) return;
      const decimals = Number(el.dataset.decimals ?? 0);
      const suffix = el.dataset.suffix ?? '';
      let done = false;
      inView(
        el,
        () => {
          if (done) return;
          done = true;
          animate(0, target, {
            duration: 1.4,
            ease: EASE,
            onUpdate: (v) => {
              el.textContent = `${v.toFixed(decimals)}${suffix}`;
            },
          }).then(() => {
            el.textContent = `${target.toFixed(decimals)}${suffix}`;
          });
        },
        { amount: 0.6 }
      );
    });
  }

  // Before / after toggle — swaps rank data in place so the same dots morph
  // from "today" to "with us". Works with or without motion; the pop is skipped
  // under prefers-reduced-motion and the swap is instant.
  const BANDS: Record<string, string[]> = {
    top: ['bg-ink', 'text-canvas'],
    mid: ['bg-block-lime', 'border', 'border-black/10', 'text-ink'],
    low: ['bg-hairline', 'text-ink'],
    risk: ['bg-block-coral', 'border', 'border-black/10', 'text-ink'],
    empty: ['bg-transparent', 'border', 'border-dashed', 'border-hairline'],
  };
  const ALL_BAND_CLASSES = [...new Set(Object.values(BANDS).flat())];
  const bandFor = (rank: number) =>
    rank === 0 ? 'empty' : rank <= 3 ? 'top' : rank <= 10 ? 'mid' : rank <= 12 ? 'low' : 'risk';

  const panel = document.querySelector<HTMLElement>('[data-geo-panel]');
  const centreIdx = Number(panel?.dataset.geoCentre ?? 31);
  const centreCol = centreIdx % 9;
  const centreRow = Math.floor(centreIdx / 9);
  const gridRegion = document.querySelector<HTMLElement>('[data-geo-grid]');
  const dotEls = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-geo-dot]'));
  const stateButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-geo-state]')
  );
  const readoutEls = Array.from(document.querySelectorAll<HTMLElement>('[data-before]'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Shared point popup (MarkerPopup pattern): one card fed by the clicked dot.
  const popup = document.querySelector<HTMLElement>('[data-geo-popup]');
  const popupTitle = popup?.querySelector<HTMLElement>('[data-geo-popup-title]');
  const popupRank = popup?.querySelector<HTMLElement>('[data-geo-popup-rank]');
  const popupBand = popup?.querySelector<HTMLElement>('[data-geo-popup-band]');
  const popupDist = popup?.querySelector<HTMLElement>('[data-geo-popup-dist]');
  let popupIdx: number | null = null;

  const BAND_LABEL: Record<string, string> = {
    top: 'Top 3 — in the pack',
    mid: 'Rank 4–10',
    low: 'Rank 11–12',
    risk: 'Rank 13+',
    empty: 'Outside the top 20',
  };

  const milesFor = (i: number) => {
    const dx = (i % 9) - centreCol;
    const dy = Math.floor(i / 9) - centreRow;
    return (Math.sqrt(dx * dx + dy * dy) * 1.8).toFixed(1);
  };

  function showPopup(i: number) {
    if (!popup || !geoStates) return;
    const rank = geoStates[geoState][i] ?? 0;
    popupIdx = i;
    const band = bandFor(rank);
    if (popupTitle) {
      popupTitle.textContent =
        rank === 0 ? `Grid point · Outside top 20` : `Grid point · Rank ${rank} · ${milesFor(i)} mi`;
    }
    if (popupRank) popupRank.textContent = rank === 0 ? 'Not ranked' : `Rank ${rank}`;
    if (popupBand) popupBand.textContent = BAND_LABEL[band] ?? '';
    if (popupDist) popupDist.textContent = `${milesFor(i)} mi from business · Jul 2025`;
    popup.hidden = false;
    if (!reduceMotion) {
      animate(
        popup,
        { opacity: [0, 1], transform: ['translateY(6px)', 'translateY(0)'] },
        { duration: 0.3, ease: EASE }
      );
    }
  }

  function hidePopup() {
    popupIdx = null;
    popup?.setAttribute('hidden', '');
  }

  let geoStates: { before: number[]; after: number[] } | null = null;
  try {
    const raw = document.querySelector('[data-geo-data]')?.textContent ?? '';
    geoStates = JSON.parse(raw);
  } catch {
    geoStates = null;
  }

  let geoState: 'before' | 'after' = 'before';

  function renderGeoState(next: 'before' | 'after') {
    if (!geoStates || next === geoState) return;
    geoState = next;
    const values = geoStates[next];

    for (const dot of dotEls) {
      const i = Number(dot.dataset.geoDot);
      if (!Number.isFinite(i) || i === centreIdx) continue;
      const rank = values[i] ?? 0;
      dot.classList.remove(...ALL_BAND_CLASSES);
      dot.classList.add(...BANDS[bandFor(rank)]);
      const num = dot.querySelector('[data-geo-num]');
      if (num) {
        num.textContent = rank === 0 ? '' : String(rank);
        num.classList.toggle('hidden', rank === 0);
      }
      const dx = (i % 9) - centreCol;
      const dy = Math.floor(i / 9) - centreRow;
      dot.setAttribute(
        'aria-label',
        rank === 0
          ? 'Outside the top 20'
          : `Rank ${rank} · ${(Math.sqrt(dx * dx + dy * dy) * 1.8).toFixed(1)} mi from business`
      );
    }

    // Keep the open popup in sync when the Today / With-us data swaps.
    if (popupIdx !== null && popup && !popup.hidden) showPopup(popupIdx);

    for (const btn of stateButtons) {
      const active = btn.dataset.geoState === next;
      btn.setAttribute('aria-pressed', String(active));
      btn.classList.toggle('bg-ink', active);
      btn.classList.toggle('text-canvas', active);
      btn.classList.toggle('text-ink', !active);
      btn.classList.toggle('hover:bg-surface-soft', !active);
    }

    for (const el of readoutEls) {
      el.textContent = next === 'after' ? (el.dataset.after ?? '') : (el.dataset.before ?? '');
    }

    if (gridRegion) {
      const label =
        next === 'after' ? gridRegion.dataset.ariaAfter : gridRegion.dataset.ariaBefore;
      if (label) gridRegion.setAttribute('aria-label', label);
    }

    if (!reduceMotion && dotEls.length) {
      animate(
        dotEls,
        { transform: ['scale(0.55)', 'scale(1)'], opacity: [0.3, 1] },
        { duration: 0.4, delay: stagger(0.02, { from: centreIdx }), ease: EASE }
      );
    }
  }

  for (const btn of stateButtons) {
    btn.addEventListener('click', () =>
      renderGeoState(btn.dataset.geoState === 'after' ? 'after' : 'before')
    );
  }

  for (const dot of dotEls) {
    dot.addEventListener('click', () => {
      const i = Number(dot.dataset.geoDot);
      if (!Number.isFinite(i)) return;
      if (popupIdx === i && popup && !popup.hidden) {
        hidePopup();
      } else {
        showPopup(i);
      }
    });
  }

  document.querySelectorAll('[data-geo-popup-close]').forEach((btn) => {
    btn.addEventListener('click', hidePopup);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') hidePopup();
  });
</script>
