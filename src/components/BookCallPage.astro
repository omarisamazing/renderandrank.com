---
/**
 * BookCallPage — shared book-a-call body for `/book-a-call` and every locale
 * wrapper (`/es/book-a-call/` …). Hero strings resolve via `useTranslations`
 * from the URL locale (`{duration}` is replaced with the Cal.com event length);
 * agenda, host-card and guarantee copy stay English until phase 3 (tracked in
 * docs/i18n.md). The Cal.com scheduler itself is a third-party embed.
 */
import Eyebrow from './ui/Eyebrow.astro';
import CalInline from './CalInline.astro';
import { siteConfig } from '../config/site';
import { Check, Mail, Phone, Video } from '@lucide/astro';
import { Picture } from 'astro:assets';
import founderAvatar from '../assets/founder-omar-ali.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { calCom, founder, contact } = siteConfig;

const agenda = [
  { title: t('bookcall.agenda.1t'), body: t('bookcall.agenda.1b') },
  { title: t('bookcall.agenda.2t'), body: t('bookcall.agenda.2b') },
  { title: t('bookcall.agenda.3t'), body: t('bookcall.agenda.3b') },
  { title: t('bookcall.agenda.4t'), body: t('bookcall.agenda.4b') },
];
---

<div class="section-y">
  <div class="container-page">
    <!-- Header -->
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <Eyebrow data-reveal>{t('bookcall.hero.eyebrow')}</Eyebrow>
      <h1 class="display-lg mt-4 text-ink" data-reveal>
        {t('bookcall.hero.title').replace('{duration}', calCom.duration)}
      </h1>
      <p class="subhead mt-5 text-ink" data-reveal>
        {t('bookcall.hero.sub')}
      </p>
    </div>

    <!-- Scheduler Hero Card (Wide for 3-column desktop view) -->
    <div class="mt-10 mx-auto max-w-5xl" data-reveal>
      <div
        class="overflow-hidden rounded-lg border border-hairline bg-canvas p-1 sm:p-3 md:p-6"
      >
        <CalInline minHeight={620} />
      </div>
    </div>

    <!-- What to expect / Agenda & Guarantee Section -->
    <div class="mt-16 mx-auto max-w-5xl border-t border-hairline pt-12 md:pt-16" data-reveal-group>
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <!-- Left: Agenda (col-span-7) -->
          <div class="lg:col-span-7" data-reveal>
            <Eyebrow>{t('bookcall.agenda.eyebrow')}</Eyebrow>
            <h2 class="card-title mt-2 text-ink">{t('bookcall.agenda.title')}</h2>
            <p class="body-sm mt-2 text-ink">
              {t('bookcall.agenda.sub')}
            </p>

          <ol class="mt-6 flex flex-col gap-5">
            {
              agenda.map((item, i) => (
                <li class="flex gap-4">
                  <span
                    class="numeric flex size-8 shrink-0 items-center justify-center rounded-full bg-surface-soft text-[0.875rem] font-medium text-ink"
                    aria-hidden="true"
                  >
                    {i + 1}
                  </span>
                  <div>
                    <p class="label text-ink font-semibold">{item.title}</p>
                    <p class="body-sm mt-1 text-ink">{item.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <!-- Right: Host & Guarantee Card (col-span-5) -->
        <div class="lg:col-span-5 flex flex-col gap-6" data-reveal data-reveal-delay="0.1">
          <!-- Host Card -->
          <div class="rounded-lg border border-hairline bg-canvas p-6">
            <div class="flex items-center gap-4 border-b border-hairline pb-4">
              <Picture
                src={founderAvatar}
                formats={['avif', 'webp']}
                fallbackFormat="png"
                alt=""
                width={112}
                height={112}
                loading="lazy"
                decoding="async"
                class="size-14 shrink-0 rounded-full border border-hairline object-cover object-top"
              />
              <div>
                <p class="card-title text-ink">{founder.name}</p>
                <p class="body-sm mt-0.5 text-ink">{founder.role}</p>
              </div>
            </div>

            <ul class="mt-4 flex flex-col gap-2.5">
              <li class="caption inline-flex items-center gap-2.5 text-ink">
                <Video class="size-4 shrink-0" aria-hidden="true" />
                {calCom.duration} video call &middot; {calCom.platform}
              </li>
              <li class="caption inline-flex items-center gap-2.5 text-ink">
                <Phone class="size-4 shrink-0" aria-hidden="true" />
                {contact.phone}
              </li>
              <li class="caption inline-flex items-center gap-2.5 text-ink">
                <Mail class="size-4 shrink-0" aria-hidden="true" />
                {contact.email}
              </li>
            </ul>
          </div>

          <!-- Guarantee Box -->
          <div class="rounded-lg bg-block-lime p-5">
              <p class="label inline-flex items-center gap-2 font-semibold text-ink">
                <Check class="size-4 shrink-0" aria-hidden="true" />
                {t('bookcall.guarantee.title')}
              </p>
              <p class="body-sm mt-1.5 text-ink">
                {t('bookcall.guarantee.body')}
              </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
