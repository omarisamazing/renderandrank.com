---
import BrandLogo from './ui/BrandLogo.astro';
import Eyebrow from './ui/Eyebrow.astro';
import { siteConfig } from '../config/site';
import { Mail, Phone } from '@lucide/astro';
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const year = new Date().getFullYear();

const columns = [
  {
    heading: t('footer.col.capabilities'),
    links: [
      { name: t('footer.link.googleMaps'), href: '/services/google-maps' },
      { name: t('footer.link.aeoGeo'), href: '/services/aeo-geo' },
      { name: t('footer.link.citations'), href: '/services/local-seo' },
      { name: t('footer.link.allServices'), href: '/services' },
    ],
  },
  {
    heading: t('footer.col.company'),
    links: [
      { name: t('footer.link.caseStudies'), href: '/portfolio' },
      { name: t('footer.link.pricing'), href: '/pricing' },
      { name: t('footer.link.roiCalculator'), href: '/calculator' },
      { name: t('footer.link.aboutOmar'), href: '/about' },
    ],
  },
  {
    heading: t('footer.col.getStarted'),
    links: [
      { name: t('footer.link.bookCall'), href: '/book-a-call' },
      { name: t('footer.link.freeAudit'), href: '/contact' },
      { name: t('footer.link.contact'), href: '/contact' },
    ],
  },
];
---

<footer class="mt-auto border-t border-hairline bg-canvas">
  <div class="container-page py-16 md:py-20">
    <div class="grid gap-12 md:grid-cols-5 md:gap-10">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="inline-block rounded-xs">
          <BrandLogo size="xl" />
        </a>

        <p class="body-sm mt-5 max-w-sm text-ink">
          {t('footer.tagline')}
        </p>

        <ul class="mt-6 flex flex-col gap-2.5">
          <li>
            <a
              href={`tel:${siteConfig.contact.phone.replace(/[^\d+]/g, '')}`}
              class="body-sm inline-flex items-center gap-2.5 text-ink transition-colors hover:underline hover:underline-offset-4"
            >
              <Phone class="size-4 shrink-0" aria-hidden="true" />
              {siteConfig.contact.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="body-sm inline-flex items-center gap-2.5 text-ink transition-colors hover:underline hover:underline-offset-4"
            >
              <Mail class="size-4 shrink-0" aria-hidden="true" />
              {siteConfig.contact.email}
            </a>
          </li>
        </ul>

        <ul class="mt-6 flex flex-wrap items-center gap-3">
          {siteConfig.socials.twitter && (
            <li>
              <a
                href={siteConfig.socials.twitter}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="X (Twitter)"
                class="inline-flex size-10 items-center justify-center rounded-full bg-surface-soft text-ink transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socials.linkedin && (
            <li>
              <a
                href={siteConfig.socials.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="inline-flex size-10 items-center justify-center rounded-full bg-surface-soft text-ink transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socials.youtube && (
            <li>
              <a
                href={siteConfig.socials.youtube}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="YouTube"
                class="inline-flex size-10 items-center justify-center rounded-full bg-surface-soft text-ink transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socials.instagram && (
            <li>
              <a
                href={siteConfig.socials.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class="inline-flex size-10 items-center justify-center rounded-full bg-surface-soft text-ink transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socials.facebook && (
            <li>
              <a
                href={siteConfig.socials.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
                class="inline-flex size-10 items-center justify-center rounded-full bg-surface-soft text-ink transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socials.tiktok && (
            <li>
              <a
                href={siteConfig.socials.tiktok}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="TikTok"
                class="inline-flex size-10 items-center justify-center rounded-full bg-surface-soft text-ink transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a>
            </li>
          )}
          {siteConfig.socials.reddit && (
            <li>
              <a
                href={siteConfig.socials.reddit}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Reddit"
                class="inline-flex size-10 items-center justify-center rounded-full bg-surface-soft text-ink transition-colors hover:bg-primary hover:text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="size-[18px]"><path d="M24 11.779c0-1.459-1.192-2.645-2.657-2.645-.715 0-1.363.286-1.84.746-1.81-1.191-4.259-1.949-6.971-2.046l1.483-4.669 4.016.941-.006.058c0 1.193.975 2.163 2.174 2.163 1.198 0 2.172-.97 2.172-2.163s-.975-2.164-2.172-2.164c-.92 0-1.704.574-2.021 1.379l-4.32-1.011c-.143-.033-.29.052-.334.193l-1.65 5.194c-2.744.072-5.229.813-7.055 2.007-.478-.46-1.126-.746-1.84-.746C1.192 9.134 0 10.32 0 11.779c0 .977.539 1.828 1.325 2.28-.047.318-.073.638-.073.965 0 3.192 3.792 5.789 8.451 5.789 4.649 0 8.443-2.597 8.443-5.789 0-.323-.025-.64-.072-.954.797-.45 1.346-1.312 1.346-2.291zM6.076 13.006c0-.786.641-1.427 1.427-1.427.786 0 1.427.641 1.427 1.427s-.641 1.428-1.427 1.428c-.786 0-1.427-.642-1.427-1.428zm7.976 3.949c-.702.702-2.038.756-2.43.756-.392 0-1.728-.054-2.43-.756-.104-.104-.104-.273 0-.377.104-.103.273-.103.377 0 .442.442 1.386.599 2.053.599.667 0 1.612-.157 2.054-.599.104-.103.273-.103.377 0 .103.104.103.273 0 .377zm-.184-2.521c-.786 0-1.427-.642-1.427-1.428s.641-1.427 1.427-1.427c.786 0 1.427.641 1.427 1.427s-.641 1.428-1.427 1.428z"/></svg>
              </a>
            </li>
          )}
        </ul>
      </div>

      <!-- Link columns -->
      {
        columns.map((column) => (
          <nav aria-labelledby={`footer-${column.heading}`}>
            <Eyebrow class="block" id={`footer-${column.heading}`}>
              {column.heading}
            </Eyebrow>
            <ul class="mt-4 flex flex-col gap-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="body-sm text-ink transition-colors hover:underline hover:underline-offset-4"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <!-- Oversized wordmark, per the supplied artwork lockup -->
  <div class="container-page overflow-hidden border-t border-hairline-soft pt-10 pb-6">
    <BrandLogo variant="stacked" size="display" class="text-ink/8 select-none" />
  </div>

  <div class="border-t border-hairline-soft">
    <div
      class="container-page flex flex-col items-center justify-between gap-4 py-6 sm:flex-row"
    >
      <div class="flex flex-col items-center gap-1.5 sm:items-start">
        <p class="caption text-ink">
          &copy; {year} {siteConfig.name} &middot; {siteConfig.domain}
        </p>
        <p class="caption text-ink">{t('footer.location')}</p>
      </div>
      <nav aria-label="Legal" class="flex items-center gap-5">
        <a
          href="/terms"
          class="caption text-ink transition-colors hover:underline hover:underline-offset-4"
        >
          {t('footer.legal.terms')}
        </a>
        <a
          href="/privacy"
          class="caption text-ink transition-colors hover:underline hover:underline-offset-4"
        >
          {t('footer.legal.privacy')}
        </a>
      </nav>
    </div>
  </div>
</footer>
