---
import { navLinks, siteConfig } from '../config/site';
import BrandLogo from './ui/BrandLogo.astro';
import Button from './ui/Button.astro';
import BookCallButton from './BookCallButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { NavMenu } from './nav/ServicesMenu';
import { MobileNav } from './nav/MobileNav';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Map a navLink to its translated label by matching name (lowercased) to a
// `nav.<name>` key, falling back to the original name when no key exists.
const navLabel = (name: string) => {
  const key = `nav.${name.toLowerCase()}` as Parameters<typeof t>[0];
  const translated = t(key);
  return translated === key ? name : translated;
};

// Locale-aware hrefs: en stays root, every other locale is prefix-mounted.
const localize = (href: string) =>
  lang === 'en' ? href : href === '/' ? `/${lang}/` : `/${lang}${href}`;

const localizedLinks = navLinks.map((link) => ({
  ...link,
  name: navLabel(link.name),
  href: localize(link.href),
  children: link.children?.map((child) => ({ ...child, href: localize(child.href) })),
}));

const currentPath = Astro.url.pathname;
const { calCom } = siteConfig;

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header
  class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/90 backdrop-blur-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a
      href={localize('/')}
      class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      <BrandLogo size="lg" />
    </a>

    <!-- Desktop links -->
    <nav aria-label="Main" class="hidden items-center gap-0.5 lg:flex">
      {
        localizedLinks.map((link) =>
          link.children ? (
            <NavMenu
              client:idle
              label={link.name}
              href={link.href}
              footerLabel={t('nav.allCapabilities')}
              items={link.children}
            />
          ) : (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'label flex h-10 items-center rounded-pill px-3.5 transition-colors',
                isActive(link.href)
                  ? 'bg-surface-soft text-ink'
                  : 'text-ink hover:bg-surface-soft',
              ]}
            >
              {link.name}
            </a>
          )
        )
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2.5">
      <LanguageSwitcher />
      <Button href={localize('/contact')} variant="secondary" size="sm" class="hidden sm:inline-flex">
        {t('nav.freeAudit')}
      </Button>
      <BookCallButton size="sm" withIcon={false} label={t('nav.bookCall')} />
      <div class="lg:hidden">
        <MobileNav
          client:media="(max-width: 1023px)"
          links={localizedLinks.map(({ name, href, children }) => ({ name, href, children }))}
          currentPath={currentPath}
          calNamespace={calCom.namespace}
          calLink={calCom.eventLink}
          menuLabel={t('nav.menu')}
          openNavLabel={t('nav.openNavigation')}
          auditLabel={t('nav.freeAudit')}
          bookCallLabel={t('nav.bookCall')}
          auditHref={localize('/contact')}
          bookHref={localize('/book-a-call')}
        />
      </div>
    </div>
  </div>
</header>
