---
/**
 * The one CTA used for booking across the site. Links to /book-a-call, where the
 * Cal.com scheduler is inlined and preloaded — no click-time popup to wait on.
 */
import { siteConfig } from '../config/site';
import Button from './ui/Button.astro';
import type { ButtonVariants } from '@/lib/button-variants';
import { ArrowRight } from '@lucide/astro';
import { getLangFromUrl } from '../i18n/utils';

type Props = ButtonVariants & {
  class?: string;
  label?: string;
  withIcon?: boolean;
};

const {
  variant = 'primary',
  size = 'md',
  block,
  class: className,
  label = 'Book a call',
  withIcon = true,
} = Astro.props;

const { calCom } = siteConfig;

const lang = getLangFromUrl(Astro.url);
const href = lang === 'en' ? '/book-a-call' : `/${lang}/book-a-call`;
---

<Button
  href={href}
  variant={variant}
  size={size}
  block={block}
  class={className}
>
  <span>{label}</span>
  {withIcon && <ArrowRight class="size-4" aria-hidden="true" />}
</Button>
