---
/**
 * The one CTA used for booking across the site. Opens the Cal.com scheduler as a
 * modal in place, so a visitor never loses the page they were reading.
 *
 * Falls back to /book-a-call when JavaScript or the embed is unavailable —
 * `href` stays on the element and Cal.com's script calls preventDefault itself.
 */
import { siteConfig } from '../config/site';
import Button from './ui/Button.astro';
import type { ButtonVariants } from '@/lib/button-variants';
import { ArrowRight } from '@lucide/astro';

type Props = ButtonVariants & {
  class?: string;
  label?: string;
  withIcon?: boolean;
};

const {
  variant = 'primary',
  size = 'md',
  block,
  class: className,
  label = 'Book a call',
  withIcon = true,
} = Astro.props;

const { calCom } = siteConfig;
---

<Button
  href="/book-a-call"
  variant={variant}
  size={size}
  block={block}
  class={className}
  data-cal-namespace={calCom.namespace}
  data-cal-link={calCom.eventLink}
  data-cal-config={JSON.stringify({ layout: 'month_view' })}
>
  <span>{label}</span>
  {withIcon && <ArrowRight class="size-4" aria-hidden="true" />}
</Button>
