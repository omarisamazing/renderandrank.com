---
/**
 * BlogPostPage — shared article body for `/blog/<slug>` and every locale
 * wrapper (`/es/blog/<slug>` …). Takes the collection `post` plus a
 * `localePrefix` ('' for EN, '/es' …) so breadcrumbs, related links and
 * schema URLs resolve inside the current locale; author-page and CTA links
 * stay root (no locale targets exist). Chrome strings resolve via
 * `useTranslations` from the URL locale; the article body, title, FAQ and
 * CTA copy stay English (MDX source) until full post translation.
 */
import { render, getCollection, type CollectionEntry } from 'astro:content';
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import CtaBanner from './CtaBanner.astro';
import { siteConfig } from '../config/site';
import { getLangFromUrl, useTranslations, blogTopicLabel, isBasePost } from '../i18n/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  localePrefix: string;
}

const { post, localePrefix } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Sibling resolution lives HERE (not in getStaticPaths, which has no URL):
// `<slug>.<locale>.md` wins when present, matched on filePath because the
// content layer mangles the id (`foo.es.md` → id `fooes` — getEntry on the
// dotted form misses). Otherwise the EN base post renders in locale chrome.
const allEntries = await getCollection('blog', ({ data }) => data.draft !== true);
const sibling =
  lang === 'en'
    ? undefined
    : allEntries.find((p) => p.filePath?.endsWith(`${post.id}.${lang}.md`));
const entry = sibling ?? post;
const topicLabel = blogTopicLabel(lang, entry.data.topic);

const { Content, headings } = await render(entry);

const updated = entry.data.updatedDate ?? entry.data.publishDate;
const wordCount = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = entry.data.readingMinutes ?? Math.max(1, Math.round(wordCount / 200));
const url = `${siteConfig.url}${localePrefix}/blog/${post.id}/`;

const h2s = headings.filter((h) => h.depth === 2);

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  image: `${siteConfig.url}/og-cover.jpg`,
  datePublished: entry.data.publishDate.toISOString(),
  dateModified: updated.toISOString(),
  author: {
    '@type': 'Person',
    '@id': `${siteConfig.url}/author/omar-ali`,
    name: siteConfig.founder.name,
    jobTitle: siteConfig.founder.role,
    description: siteConfig.founder.bio,
    url: `${siteConfig.url}/author/omar-ali`,
    knowsAbout: siteConfig.founder.knowsAbout,
    sameAs: siteConfig.founder.sameAs,
    worksFor: { '@id': `${siteConfig.url}/#business` },
  },
  publisher: { '@id': `${siteConfig.url}/#business` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: topicLabel,
  inLanguage: lang === 'en' ? 'en-US' : lang,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home'), item: `${siteConfig.url}${localePrefix}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteConfig.url}${localePrefix}/blog` },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
  ],
};

const faqSchema =
  entry.data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: entry.data.faq.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: { '@type': 'Answer', text: faq.a },
        })),
      }
    : null;

// Related posts: explicit slugs first, then same-topic fill (base posts only).
const allPosts = allEntries.filter(isBasePost);
const bySlug = new Map(allPosts.map((p) => [p.id, p]));
const related = [
  ...entry.data.related.map((slug) => bySlug.get(slug)).filter((p) => p && p.id !== post.id),
  ...allPosts.filter(
    (p) => p.id !== post.id && p.data.topic === entry.data.topic && !entry.data.related.includes(p.id)
  ),
].slice(0, 3);
---

<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<div class="border-b border-hairline bg-canvas py-16 md:py-20">
  <div class="container-page">
    <div class="mx-auto max-w-3xl" data-reveal-group>
      <nav aria-label="Breadcrumb" data-reveal>
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={`${localePrefix}/`} class="caption text-ink hover:underline hover:underline-offset-4">{t('nav.home')}</a></li>
          <li aria-hidden="true" class="caption text-ink">/</li>
          <li><a href={`${localePrefix}/blog`} class="caption text-ink hover:underline hover:underline-offset-4">Blog</a></li>
          <li aria-hidden="true" class="caption text-ink">/</li>
          <li aria-current="page" class="caption text-ink">{topicLabel}</li>
        </ol>
      </nav>
      <Eyebrow data-reveal>{topicLabel}</Eyebrow>
      <h1 class="display-lg mt-4 text-ink" data-reveal>{entry.data.title}</h1>
      <p class="subhead mt-5 text-ink" data-reveal>{entry.data.description}</p>
      <p class="body-sm mt-6 text-ink" data-reveal>
        {t('blog.post.by')} <a href="/author/omar-ali" class="font-medium underline underline-offset-4">{entry.data.author}</a>
        <span aria-hidden="true"> · </span>
        <time datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {entry.data.updatedDate && (
          <span>
            <span aria-hidden="true"> · </span>
            {t('blog.post.updated')} <time datetime={entry.data.updatedDate.toISOString()}>
              {entry.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </span>
        )}
        <span aria-hidden="true"> · </span>
        {readingMinutes} {t('blog.post.minRead')}
      </p>
    </div>
  </div>
</div>

<Section>
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
    {h2s.length > 0 && (
      <aside class="lg:col-span-4" data-reveal>
        <nav aria-label="Table of contents" class="lg:sticky lg:top-24 rounded-lg border border-hairline bg-canvas p-6">
          <p class="eyebrow text-ink">{t('blog.post.toc')}</p>
          <ol class="mt-4 flex flex-col gap-2.5">
            {h2s.map((h) => (
              <li>
                <a href={`#${h.slug}`} class="body-sm text-ink hover:underline hover:underline-offset-4">
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
    <div class:list={['min-w-0', h2s.length > 0 ? 'lg:col-span-8' : 'lg:col-span-8 lg:col-start-3']} data-reveal>
      <div class="blog-prose">
        <Content />
      </div>
    </div>
  </div>
</Section>

{entry.data.faq.length > 0 && (
  <Section divider>
    <div class="mx-auto max-w-3xl">
      <div data-reveal-group>
        <Eyebrow data-reveal>{t('blog.post.faqEyebrow')}</Eyebrow>
        <h2 class="display-md mt-4 text-ink" data-reveal>{t('blog.post.faqTitle')}</h2>
      </div>
      <dl class="mt-10 flex flex-col divide-y divide-hairline border-y border-hairline">
        {entry.data.faq.map((faq) => (
          <div class="py-7">
            <dt class="card-title text-ink">{faq.q}</dt>
            <dd class="body mt-3 text-ink">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>
)}

{/* Post CTA: per-post override or the 24h-audit hook */}
<Section divider>
  <div class="color-block color-block-lime color-block--bleed">
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <Eyebrow tone="on-block" data-reveal>{t('blog.post.ctaEyebrow')}</Eyebrow>
      <h2 class="display-md mt-4 text-ink" data-reveal>
        {entry.data.cta?.title ?? 'See what AI says about your business'}
      </h2>
      <p class="subhead mt-4 text-ink" data-reveal>
        {entry.data.cta?.body ?? 'Run the free checker to see if answer engines recommend you — or send your buyers to competitors.'}
      </p>
      <div class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center" data-reveal>
        <Button href={entry.data.cta?.primaryHref ?? '/check'} variant="primary" size="lg">
          {entry.data.cta?.primaryLabel ?? 'Run the free AI check'}
        </Button>
        <Button href={entry.data.cta?.secondaryHref ?? '/calculator'} variant="secondary" size="lg">
          {entry.data.cta?.secondaryLabel ?? 'Estimate the upside'}
        </Button>
      </div>
    </div>
  </div>
</Section>

{related.length > 0 && (
  <Section divider>
    <div data-reveal-group>
      <Eyebrow data-reveal>{t('blog.post.relatedEyebrow')}</Eyebrow>
      <h2 class="display-md mt-4 text-ink" data-reveal>{t('blog.post.relatedTitle')}</h2>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3" data-reveal-group>
      {related.map((rel) => rel && (
        <a
          href={`${localePrefix}/blog/${rel.id}/`}
          class="rounded-lg border border-hairline bg-canvas p-6 transition-colors hover:border-ink/25"
          data-reveal
        >
          <p class="eyebrow text-ink">{blogTopicLabel(lang, rel.data.topic)}</p>
          <h3 class="card-title mt-3 text-ink">{rel.data.title}</h3>
          <p class="body-sm mt-3 text-ink">{rel.data.description}</p>
        </a>
      ))}
    </div>
  </Section>
)}

<CtaBanner />

<style is:global>
  /* Article body rhythm: generous measure, clear hierarchy, no new tokens. */
  .blog-prose {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-ink);
    overflow-wrap: break-word;
  }
  .blog-prose > * + * {
    margin-top: 1.5rem;
  }
  .blog-prose h2 {
    font-size: 1.625rem;
    font-weight: 540;
    line-height: 1.35;
    letter-spacing: -0.016em;
    padding-top: 1rem;
    scroll-margin-top: 5.5rem;
  }
  .blog-prose h3 {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.45;
    padding-top: 0.5rem;
  }
  .blog-prose a {
    font-weight: 480;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .blog-prose ul,
  .blog-prose ol {
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .blog-prose ul {
    list-style: disc;
  }
  .blog-prose ol {
    list-style: decimal;
  }
  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.5;
  }
  .blog-prose th,
  .blog-prose td {
    border: 1px solid var(--color-hairline);
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
  }
  .blog-prose th {
    background: var(--color-surface-soft);
    font-weight: 700;
  }
  .blog-prose blockquote {
    border-left: 3px solid var(--color-ink);
    padding-left: 1.25rem;
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .blog-prose pre {
    background: var(--color-inverse-canvas);
    color: var(--color-inverse-ink);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .blog-prose code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
  }
  .blog-prose :not(pre) > code {
    background: var(--color-surface-soft);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
</style>
