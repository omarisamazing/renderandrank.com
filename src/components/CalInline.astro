---
/**
 * Inline Cal.com scheduler. Reuses the namespace initialised by
 * `CalScript.astro`, so the embed script is fetched once per page.
 *
 * Once a booking lands, the calendar stays in place and a global toast
 * confirms the booking on the `rr:booking-confirmed` event that
 * `CalScript.astro` dispatches.
 */
import { siteConfig } from '../config/site';

interface Props {
  class?: string;
  minHeight?: number;
}

const { class: className = '', minHeight = 560 } = Astro.props;
const { calCom } = siteConfig;
---

<div class:list={['w-full', className]}>
  <div id="cal-inline" style={`min-height:${minHeight}px`}>
    <noscript>
      <p class="body-sm p-6">
        The scheduler needs JavaScript. You can also book directly at
        <a
          class="font-medium underline underline-offset-4"
          href={`https://cal.com/${calCom.eventLink}`}
          >cal.com/{calCom.eventLink}</a
        >, or email
        <a
          class="font-medium underline underline-offset-4"
          href={`mailto:${siteConfig.contact.email}`}
          >{siteConfig.contact.email}</a
        >.
      </p>
    </noscript>
  </div>
</div>

<script
  is:inline
  define:vars={{ namespace: calCom.namespace, link: calCom.eventLink }}
>
  Cal.ns[namespace]('inline', {
    elementOrSelector: '#cal-inline',
    calLink: link,
    config: { layout: 'column_view' },
  });

  document.addEventListener(
    'rr:booking-confirmed',
    function () {
      // Keep the Cal.com calendar in place; the global toast confirms the booking.
      window.dispatchEvent(new CustomEvent('show-toast', { detail: { message: "You're booked! A calendar invite and your Cal Video link are on their way to your email.", type: 'success' } }));
    },
    { once: true }
  );
</script>
