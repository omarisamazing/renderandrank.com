---
/**
 * Floating streaming chat widget. Fixed bottom-right launcher toggles a
 * dialog panel that streams assistant replies from `/api/chat` over SSE.
 *
 * On-brand per DESIGN.md: monochrome ink/canvas chrome, pill launcher,
 * hairline borders, --radius / --spacing tokens, brand easing. Sits above
 * the FloatingCalButton (which occupies bottom-4 / sm:bottom-6) by offsetting
 * its own baseline so the two never overlap.
 *
 * Dependency-free: vanilla JS in the module <script> below.
 */
import { MessageCircle, X, ArrowUp, Keyboard, Mic } from '@lucide/astro';
---

<div id="rr-chat" class="rr-chat" data-open="false">
  <!-- Launcher -->
  <button
    type="button"
    id="rr-chat-launcher"
    class="rr-chat__launcher"
    aria-label="Open chat with Render and Rank"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="rr-chat-panel"
  >
    <MessageCircle class="rr-chat__launcher-icon rr-chat__launcher-icon--open" aria-hidden="true" />
    <X class="rr-chat__launcher-icon rr-chat__launcher-icon--close" aria-hidden="true" />
  </button>

  <!-- Launcher greeting popup: a small speech bubble that nudges the visitor.
       Shown a moment after load while the panel is closed; dismissible. -->
  <div class="rr-chat__greeting" id="rr-chat-greeting" role="status" hidden>
    <span class="rr-chat__greeting-text">Hi there! How can I help you today?</span>
    <button
      type="button"
      id="rr-chat-greeting-close"
      class="rr-chat__greeting-close"
      aria-label="Dismiss greeting"
    >×</button>
    <span class="rr-chat__greeting-tail" aria-hidden="true"></span>
  </div>

  <!-- Panel -->
  <section
    id="rr-chat-panel"
    class="rr-chat__panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="rr-chat-title"
    hidden
  >
    <header class="rr-chat__header">
      <h2 id="rr-chat-title" class="rr-chat__title">Chat with Render and Rank</h2>
      <button
        type="button"
        id="rr-chat-close"
        class="rr-chat__close"
        aria-label="Close chat"
      >
        <X class="rr-chat__close-icon" aria-hidden="true" />
      </button>
    </header>

    <!-- Type / Talk mode toggle. Type is the default; Talk starts a Gemini
         Live voice session. A dot on the Talk tab lights up while recording. -->
    <div
      id="rr-chat-modes"
      class="rr-chat__modes"
      role="tablist"
      aria-label="Chat mode"
    >
      <button
        type="button"
        id="rr-chat-mode-type"
        class="rr-chat__mode rr-chat__mode--active"
        role="tab"
        aria-selected="true"
        data-mode="type"
      >
        <Keyboard class="rr-chat__mode-icon" aria-hidden="true" />
        <span>Type</span>
      </button>
      <button
        type="button"
        id="rr-chat-mode-talk"
        class="rr-chat__mode"
        role="tab"
        aria-selected="false"
        data-mode="talk"
      >
        <Mic class="rr-chat__mode-icon" aria-hidden="true" />
        <span>Talk</span>
        <span class="rr-chat__mode-dot" id="rr-chat-live-dot" aria-hidden="true"></span>
      </button>
    </div>

    <div
      id="rr-chat-log"
      class="rr-chat__log"
      role="log"
      aria-live="polite"
      aria-relevant="additions text"
    ></div>

    <!-- Talk-mode message surface. Kept parallel to (and separate from)
         #rr-chat-log so voice/Talk transcripts never bleed into the Text
         chat. Only one of the two logs is visible at a time (toggled in
         switchMode); hidden by default since Type is the default mode. -->
    <div
      id="rr-chat-voicelog"
      class="rr-chat__log rr-chat__log--hidden"
      role="log"
      aria-live="polite"
      aria-relevant="additions text"
    ></div>

    <!-- Prominent voice status bar: shown while a voice session is connecting
         or live. Animated equalizer + label + a Stop button to end voice.
         Rendered at the BOTTOM of the panel (below the message log, above the
         composer) so it never covers the conversation. -->
    <div class="rr-chat__voicebar" id="rr-chat-voicebar" role="status" aria-live="polite" hidden>
      <span class="rr-chat__voicebar-anim" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="rr-chat__voicebar-label" id="rr-chat-voicebar-label">Listening…</span>
      <button type="button" class="rr-chat__voicebar-stop" id="rr-chat-voice-stop">Stop</button>
      <!-- Idle-phase action: Start talking after a user Stop, Reconnect after
           a drop/error. Shown only when no session is live (see showTalkIdle /
           showVoiceError); the Stop button shows only while live. -->
      <button type="button" class="rr-chat__voicebar-start" id="rr-chat-voice-start" hidden>Start talking</button>
    </div>

    <form id="rr-chat-form" class="rr-chat__form">
      <label for="rr-chat-input" class="sr-only">Type your message</label>
      <textarea
        id="rr-chat-input"
        class="rr-chat__input"
        rows="1"
        placeholder="Ask us anything…"
        autocomplete="off"
      ></textarea>
      <button
        type="submit"
        id="rr-chat-send"
        class="rr-chat__send"
        aria-label="Send message"
      >
        <ArrowUp class="rr-chat__send-icon" aria-hidden="true" />
      </button>
    </form>
  </section>
</div>

<style>
  .rr-chat {
    position: fixed;
    right: 1rem;
    /* Stack above FloatingCalButton (bottom-4 = 1rem, pill ~52px tall). */
    bottom: 4.75rem;
    z-index: 45;
  }

  @media (width >= 640px) {
    .rr-chat {
      right: 1.5rem;
      bottom: 5.5rem;
    }
  }

  /* ---- Launcher --------------------------------------------------------- */
  .rr-chat__launcher {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-left: auto;
    border: none;
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-ink, #000);
    color: var(--color-inverse-ink, #fff);
    cursor: pointer;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
    transition: transform 200ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__launcher:hover {
    transform: translateY(-2px);
  }

  .rr-chat__launcher-icon {
    width: 1.375rem;
    height: 1.375rem;
    position: absolute;
    transition: opacity 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__launcher-icon--close { opacity: 0; }
  .rr-chat[data-open='true'] .rr-chat__launcher-icon--open { opacity: 0; }
  .rr-chat[data-open='true'] .rr-chat__launcher-icon--close { opacity: 1; }

  /* ---- Panel ------------------------------------------------------------ */
  .rr-chat__panel {
    position: absolute;
    right: 0;
    bottom: calc(3.25rem + 0.75rem);
    display: flex;
    flex-direction: column;
    width: min(23rem, calc(100vw - 2rem));
    height: min(32rem, calc(100vh - 8rem));
    background-color: var(--color-canvas, #fff);
    border: 1px solid var(--color-hairline, #e6e6e6);
    border-radius: var(--radius-lg, 24px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.16);
    overflow: hidden;
    transform-origin: bottom right;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transition:
      opacity 200ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1)),
      transform 200ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat[data-open='true'] .rr-chat__panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (width < 480px) {
    .rr-chat__panel {
      position: fixed;
      right: 0.5rem;
      left: 0.5rem;
      bottom: 0.5rem;
      width: auto;
      height: min(80vh, 34rem);
    }
  }

  .rr-chat__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--color-hairline, #e6e6e6);
    background-color: var(--color-canvas, #fff);
  }

  .rr-chat__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 540;
    letter-spacing: -0.006em;
    color: var(--color-ink, #000);
  }

  .rr-chat__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-surface-soft, #f7f7f5);
    color: var(--color-ink, #000);
    cursor: pointer;
    transition: background-color 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__close:hover { background-color: var(--color-hairline, #e6e6e6); }
  .rr-chat__close-icon { width: 1rem; height: 1rem; }

  /* ---- Type / Talk mode toggle ------------------------------------------ */
  .rr-chat__modes {
    display: flex;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-hairline, #e6e6e6);
    background-color: var(--color-canvas, #fff);
  }

  .rr-chat__mode {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    flex: 1;
    justify-content: center;
    padding: 0.4375rem 0.625rem;
    border: 1px solid var(--color-hairline, #e6e6e6);
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-canvas, #fff);
    color: var(--color-ink, #000);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 460;
    letter-spacing: -0.006em;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1)),
      border-color 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1)),
      color 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__mode:hover { background-color: var(--color-surface-soft, #f7f7f5); }

  /* Active tab reads as a filled ink pill (matches the send button chrome). */
  .rr-chat__mode--active {
    background-color: var(--color-ink, #000);
    border-color: var(--color-ink, #000);
    color: var(--color-inverse-ink, #fff);
  }

  .rr-chat__mode--active:hover { background-color: var(--color-ink, #000); }

  .rr-chat__mode:focus-visible {
    outline: 2px solid var(--color-ink, #000);
    outline-offset: 2px;
  }

  .rr-chat__mode-icon { width: 0.9375rem; height: 0.9375rem; }

  /* Recording/live indicator dot on the Talk tab; only shown while live. */
  .rr-chat__mode-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--color-block-pink, #efd4d4);
    opacity: 0;
    transition: opacity 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__modes[data-live='true'] .rr-chat__mode-dot {
    opacity: 1;
    background-color: #e5484d; /* live-red; distinct from the muted pink block */
    animation: rr-chat-pulse 1.4s ease-in-out infinite;
  }

  @keyframes rr-chat-pulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.35); opacity: 0.55; }
  }

  /* ---- Launcher greeting popup ------------------------------------------ */
  /* Small speech bubble anchored above the launcher; matches widget chrome. */
  .rr-chat__greeting {
    position: absolute;
    right: 0;
    bottom: calc(3.25rem + 0.75rem);
    /* Force a normal horizontal sentence layout regardless of any inherited
       vertical writing-mode or narrow launcher width. */
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    width: max-content;
    max-width: 280px;
    white-space: normal;
    padding: 0.625rem 0.75rem;
    background-color: var(--color-canvas, #fff);
    color: var(--color-ink, #000);
    border: 1px solid var(--color-hairline, #e6e6e6);
    border-radius: var(--radius-lg, 16px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
    z-index: 46;
    opacity: 0;
    transform: translateY(6px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 260ms var(--ease-brand, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 260ms var(--ease-brand, cubic-bezier(0.16, 1, 0.3, 1));
    pointer-events: none;
  }

  .rr-chat__greeting[data-shown='true'] {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .rr-chat__greeting-text {
    /* Defensive: guarantee horizontal text flow with graceful wrapping even if
       an ancestor sets a vertical writing-mode or a tiny inherited width. */
    writing-mode: horizontal-tb;
    white-space: normal;
    word-break: normal;
    overflow-wrap: break-word;
    text-orientation: mixed;
    min-width: 0;
    flex: 1 1 auto;
    line-height: 1.4;
    font-size: 0.8125rem;
    letter-spacing: -0.006em;
  }

  .rr-chat__greeting-close {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    border: none;
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-surface-soft, #f7f7f5);
    color: var(--color-ink, #000);
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__greeting-close:hover { background-color: var(--color-hairline, #e6e6e6); }

  .rr-chat__greeting-close:focus-visible {
    outline: 2px solid var(--color-ink, #000);
    outline-offset: 2px;
  }

  /* Small tail/pointer toward the launcher icon (bottom-right corner). */
  .rr-chat__greeting-tail {
    position: absolute;
    right: 1.25rem;
    bottom: -0.4rem;
    width: 0.8rem;
    height: 0.8rem;
    background-color: var(--color-canvas, #fff);
    border-right: 1px solid var(--color-hairline, #e6e6e6);
    border-bottom: 1px solid var(--color-hairline, #e6e6e6);
    transform: rotate(45deg);
  }

  /* ---- Voice status bar ------------------------------------------------- */
  /* Prominent bar shown while connecting/live so the user can tell voice is
     active, with an animated equalizer and a Stop button. */
  .rr-chat__voicebar {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
    /* Sits at the bottom of the panel now (below the log, above the composer),
       so use a top border to separate it from the log rather than a bottom one. */
    border-top: 1px solid var(--color-hairline, #e6e6e6);
    background-color: var(--color-surface-soft, #f7f7f5);
    color: var(--color-ink, #000);
    flex-shrink: 0;
    /* Smooth fade/slide when it appears at the bottom. */
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 240ms var(--ease-brand, cubic-bezier(0.16, 1, 0.3, 1)),
      transform 240ms var(--ease-brand, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .rr-chat__voicebar[hidden] {
    opacity: 0;
    transform: translateY(6px);
    display: none;
  }

  .rr-chat__voicebar-anim {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.1875rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .rr-chat__voicebar-anim i {
    display: block;
    width: 0.1875rem;
    height: 0.375rem;
    border-radius: var(--radius-pill, 50px);
    background-color: #e5484d; /* live-red, matches the Talk-tab dot */
    animation: rr-chat-eq 1s ease-in-out infinite;
  }

  .rr-chat__voicebar-anim i:nth-child(2) { animation-delay: 0.18s; }
  .rr-chat__voicebar-anim i:nth-child(3) { animation-delay: 0.36s; }

  /* While only connecting, dim the bars a touch (label reads "Connecting…"). */
  .rr-chat__voicebar[data-phase='connecting'] .rr-chat__voicebar-anim i {
    background-color: var(--color-ink, #000);
    opacity: 0.55;
  }

  /* Error phase: Talk-only surface for mic/voice errors. Tint the bar with the
     brand pink block and freeze the equalizer so it reads as a message, not a
     live session. This keeps voice errors out of the shared text chat log. */
  .rr-chat__voicebar[data-phase='error'] {
    background-color: var(--color-block-pink, #efd4d4);
  }

  .rr-chat__voicebar[data-phase='error'] .rr-chat__voicebar-anim i {
    background-color: var(--color-ink, #000);
    opacity: 0.4;
    animation: none;
  }

  @keyframes rr-chat-eq {
    0%, 100% { height: 0.375rem; }
    50% { height: 1.125rem; }
  }

  .rr-chat__voicebar-label {
    flex: 1;
    font-size: 0.8125rem;
    font-weight: 460;
    letter-spacing: -0.006em;
  }

  .rr-chat__voicebar-stop {
    flex-shrink: 0;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--color-ink, #000);
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-ink, #000);
    color: var(--color-inverse-ink, #fff);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    cursor: pointer;
    transition: opacity 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__voicebar-stop:hover { opacity: 0.85; }

  .rr-chat__voicebar-stop:focus-visible {
    outline: 2px solid var(--color-ink, #000);
    outline-offset: 2px;
  }

  /* Idle-phase action (Start talking / Reconnect): inverted pill — only one
     of Stop / Start is ever visible (toggled via hidden). */
  .rr-chat__voicebar-start {
    flex-shrink: 0;
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--color-ink, #000);
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-canvas, #fff);
    color: var(--color-ink, #000);
    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    cursor: pointer;
    transition: opacity 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__voicebar-start:hover { opacity: 0.85; }

  .rr-chat__voicebar-start:focus-visible {
    outline: 2px solid var(--color-ink, #000);
    outline-offset: 2px;
  }

  /* Idle phase: freeze + dim the equalizer so the bar reads "off", and hide
     the animation from nothing (it carries no information when idle). */
  .rr-chat__voicebar[data-phase='idle'] .rr-chat__voicebar-anim i {
    background-color: var(--color-ink, #000);
    opacity: 0.3;
    animation: none;
  }

  /* First-visit Talk hint: one-line explainer shown once above the idle bar
     when the Talk log is still empty. */
  :global(.rr-chat__voice-hint) {
    align-self: stretch;
    margin: 0;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-lg, 24px);
    background-color: var(--color-surface-soft, #f7f7f5);
    color: #55554f;
    font-size: 0.8125rem;
    line-height: 1.5;
    letter-spacing: -0.004em;
  }

  /* ---- Message log ------------------------------------------------------ */
  .rr-chat__log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem;
    overflow-y: auto;
    background-color: var(--color-canvas, #fff);
  }

  /* Only one message surface (#rr-chat-log or #rr-chat-voicelog) is visible at
     a time — switchMode toggles this class so the two logs never stack or
     overlap. Use display:none so the hidden log takes no layout space. */
  .rr-chat__log--hidden {
    display: none;
  }

  /* Divider between retained Talk sessions (temp in-session transcript memory). */
  .rr-chat__voice-divider {
    border-top: 1px solid var(--color-hairline, #e6e6e6);
    margin: 8px 0;
    opacity: 0.5;
  }

  :global(.rr-chat__msg) {
    max-width: 85%;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-lg, 24px);
    font-size: 0.9375rem;
    line-height: 1.5;
    letter-spacing: -0.006em;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  :global(.rr-chat__msg--assistant) {
    align-self: flex-start;
    background-color: var(--color-surface-soft, #f7f7f5);
    color: var(--color-ink, #000);
    border-bottom-left-radius: var(--radius-sm, 6px);
  }

  :global(.rr-chat__msg--user) {
    align-self: flex-end;
    background-color: var(--color-ink, #000);
    color: var(--color-inverse-ink, #fff);
    border-bottom-right-radius: var(--radius-sm, 6px);
  }

  :global(.rr-chat__msg--error) {
    align-self: flex-start;
    background-color: var(--color-block-pink, #efd4d4);
    color: var(--color-ink, #000);
    border-bottom-left-radius: var(--radius-sm, 6px);
  }

  /* ---- Typing indicator ------------------------------------------------- */
  /* Placeholder assistant bubble while waiting for the first stream token:
     three dots, ink at low emphasis. Static dots under reduced-motion. */
  :global(.rr-chat__msg--typing) {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 1.5em;
  }

  :global(.rr-chat__dot) {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background-color: currentColor;
    opacity: 0.3;
    animation: rr-typing-blink 1.1s ease-in-out infinite;
  }

  :global(.rr-chat__dot:nth-child(2)) { animation-delay: 0.18s; }
  :global(.rr-chat__dot:nth-child(3)) { animation-delay: 0.36s; }

  @keyframes rr-typing-blink {
    0%, 100% { opacity: 0.25; }
    50% { opacity: 1; }
  }

  /* ---- Retry + stop ----------------------------------------------------- */
  :global(.rr-chat__retry) {
    display: inline-flex;
    align-items: center;
    margin-top: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-ink, #000);
    border-radius: var(--radius-pill, 50px);
    background-color: transparent;
    color: var(--color-ink, #000);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 480;
    cursor: pointer;
  }

  :global(.rr-chat__retry:hover) {
    background-color: var(--color-ink, #000);
    color: var(--color-canvas, #fff);
  }

  :global(.rr-chat__retry:focus-visible) {
    outline: 2px solid var(--color-ink, #000);
    outline-offset: 2px;
  }

  .rr-chat__stop-icon {
    display: block;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 2px;
    background-color: currentColor;
  }

  /* ---- Markdown-lite (assistant bubbles) -------------------------------- */
  /* renderRichText() emits only these elements — escaped first, so no raw
     HTML from the model ever reaches the DOM. */
  :global(.rr-chat__link) {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  :global(.rr-chat__link:hover) {
    text-decoration-thickness: 2px;
  }

  :global(.rr-chat__list) {
    margin: 0.375rem 0 0.125rem;
    padding-left: 1.125rem;
  }

  :global(.rr-chat__list li) {
    margin: 0.125rem 0;
  }

  :global(.rr-chat__msg code) {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.85em;
    padding: 0.1em 0.3em;
    border-radius: 4px;
    background-color: rgba(127, 127, 127, 0.15);
  }

  /* ---- Suggested prompt chips ------------------------------------------- */
  /* Lightweight pill buttons: hairline outline on a near-panel ground so they
     read as gentle suggestions, not filled blocks. Wrap naturally inside the
     ~23rem panel — no icon-card grid. */
  :global(.rr-chat__suggestions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-self: stretch;
    margin-top: 0.125rem;
  }

  :global(.rr-chat__chip) {
    display: inline-flex;
    align-items: center;
    padding: 0.4375rem 0.75rem;
    text-align: left;
    border: 1px solid var(--color-hairline, #e6e6e6);
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-canvas, #fff);
    color: var(--color-ink, #000);
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 420;
    line-height: 1.3;
    letter-spacing: -0.006em;
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1)),
      border-color 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  :global(.rr-chat__chip:hover) {
    background-color: var(--color-surface-soft, #f7f7f5);
    border-color: var(--color-ink, #000);
  }

  :global(.rr-chat__chip:focus-visible) {
    outline: 2px solid var(--color-ink, #000);
    outline-offset: 2px;
  }

  /* ---- Form ------------------------------------------------------------- */
  .rr-chat__form {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--color-hairline, #e6e6e6);
    background-color: var(--color-canvas, #fff);
  }

  .rr-chat__input {
    flex: 1;
    resize: none;
    max-height: 7rem;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--color-hairline, #e6e6e6);
    border-radius: var(--radius-md, 8px);
    background-color: var(--color-canvas, #fff);
    color: var(--color-ink, #000);
    font-family: inherit;
    font-size: 0.9375rem;
    line-height: 1.45;
    letter-spacing: -0.006em;
  }

  .rr-chat__input:focus-visible {
    outline: 2px solid var(--color-ink, #000);
    outline-offset: 1px;
  }

  .rr-chat__send {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: var(--radius-pill, 50px);
    background-color: var(--color-ink, #000);
    color: var(--color-inverse-ink, #fff);
    cursor: pointer;
    transition: opacity 160ms var(--ease-brand, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .rr-chat__send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .rr-chat__send-icon { width: 1.125rem; height: 1.125rem; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .rr-chat__launcher,
    .rr-chat__launcher-icon,
    .rr-chat__panel,
    .rr-chat__close,
    .rr-chat__send,
    .rr-chat__mode,
    .rr-chat__mode-dot,
    :global(.rr-chat__chip) {
      transition: none !important;
    }
    .rr-chat__launcher:hover { transform: none; }
    .rr-chat__modes[data-live='true'] .rr-chat__mode-dot { animation: none; }
    .rr-chat__greeting,
    .rr-chat__voicebar,
    .rr-chat__voicebar-stop {
      transition: none !important;
    }
    .rr-chat__voicebar-anim i { animation: none; }
    :global(.rr-chat__dot) { animation: none !important; opacity: 0.6; }
  }
</style>

<script>
  import { getClientVisitorData } from '../lib/visitorClient';
  import { VoiceSession } from '../lib/voiceSession';
  import type { VoiceState, VoiceTurn } from '../lib/voiceSession';

  // This is a plain bundled module <script> (no define:vars), so the ESM import
  // above resolves normally in the browser and getClientVisitorData() runs at
  // runtime when a message is sent. No inline fix needed here.

  const CID_KEY = 'rr_chat_cid';
  const GREETING =
    "Hi, I'm Omli, the Render and Rank assistant. I help with local SEO and getting your business found online. What can I help you with today?";

  // Conversation id, threaded across requests within a session.
  let conversationId: string | null = sessionStorage.getItem(CID_KEY);

  // In-memory transcript sent to the API on every turn.
  const messages: { role: 'user' | 'assistant'; content: string }[] = [];

  // In-session voice memory: finalized Talk turns for this page load. Mirrors
  // the typed-text `messages` array above, but for voice — it persists across
  // Stop/Start and Type<->Talk toggles and is seeded into each new Live session
  // so the assistant remembers earlier Talk exchanges. Resets only on a full
  // page reload (module re-evaluation), consistent with the on-screen Talk
  // transcript retention added in commit aeb4fbb.
  const voiceTurns: VoiceTurn[] = [];

  let isStreaming = false;
  let greeted = false;
  let userHasMessaged = false;
  // Abort controller for the in-flight stream; the send button doubles as
  // Stop while streaming (see setStreaming + handleComposerSubmit).
  let streamAbort: AbortController | null = null;
  // Last sent user text — powers the error-bubble Retry without echoing a
  // duplicate user bubble or re-pushing history.
  let lastUserText = '';
  // Active input mode: text/SSE ('type', default) or Gemini Live voice ('talk').
  let currentMode: 'type' | 'talk' = 'type';

  const root = document.getElementById('rr-chat');
  const launcher = document.getElementById('rr-chat-launcher') as HTMLButtonElement | null;
  const panel = document.getElementById('rr-chat-panel') as HTMLElement | null;
  const closeBtn = document.getElementById('rr-chat-close') as HTMLButtonElement | null;
  const log = document.getElementById('rr-chat-log');
  // Separate Talk-mode message surface so voice transcripts never bleed into
  // the Text chat log. Only one of the two is visible at a time (switchMode).
  const voicelog = document.getElementById('rr-chat-voicelog');
  const form = document.getElementById('rr-chat-form') as HTMLFormElement | null;
  const input = document.getElementById('rr-chat-input') as HTMLTextAreaElement | null;
  const sendBtn = document.getElementById('rr-chat-send') as HTMLButtonElement | null;
  // Original send-button markup (server-rendered ArrowUp icon), restored by
  // setStreaming(false) after each stream.
  const SEND_ICON_HTML: string = sendBtn ? sendBtn.innerHTML : '';
  const modes = document.getElementById('rr-chat-modes') as HTMLElement | null;
  const modeTypeBtn = document.getElementById('rr-chat-mode-type') as HTMLButtonElement | null;
  const modeTalkBtn = document.getElementById('rr-chat-mode-talk') as HTMLButtonElement | null;
  // Voice status bar (visible listening/connecting indicator + Stop) and the
  // dismissible launcher greeting popup. Optional — guarded before use.
  const voicebar = document.getElementById('rr-chat-voicebar') as HTMLElement | null;
  const voicebarLabel = document.getElementById('rr-chat-voicebar-label') as HTMLElement | null;
  const voiceStopBtn = document.getElementById('rr-chat-voice-stop') as HTMLButtonElement | null;
  // Idle-phase action button (Start talking / Reconnect). Visible only when
  // no session is live; Stop shows only while live. See showTalkIdle.
  const voiceStartBtn = document.getElementById('rr-chat-voice-start') as HTMLButtonElement | null;
  const greeting = document.getElementById('rr-chat-greeting') as HTMLElement | null;
  const greetingCloseBtn = document.getElementById('rr-chat-greeting-close') as HTMLButtonElement | null;

  if (root && launcher && panel && closeBtn && log && voicelog && form && input && sendBtn && modes && modeTypeBtn && modeTalkBtn) {
    // Scroll whichever log is currently active to the bottom. Type mode uses
    // #rr-chat-log; Talk mode uses #rr-chat-voicelog.
    function scrollToBottom() {
      const active = currentMode === 'talk' && voicelog ? voicelog : log!;
      active.scrollTop = active.scrollHeight;
    }

    // Generic bubble creator: appends into an explicit container so text and
    // voice transcripts can live in separate surfaces.
    function addBubbleTo(
      container: HTMLElement,
      role: 'user' | 'assistant' | 'error',
      text: string
    ): HTMLElement {
      const el = document.createElement('div');
      el.className = 'rr-chat__msg rr-chat__msg--' + role;
      el.textContent = text;
      container.appendChild(el);
      scrollToBottom();
      return el;
    }

    // Text-mode bubbles (greeting / typed chat / text errors) always go to the
    // Text chat log.
    function addBubble(role: 'user' | 'assistant' | 'error', text: string): HTMLElement {
      return addBubbleTo(log!, role, text);
    }

    // Ready-made starter questions shown on first open, rendered as simple
    // pill buttons (see renderSuggestions below). Each string is both the
    // display label and the message sent when its pill is clicked.
    const SUGGESTIONS: string[] = [
      'What is local SEO?',
      'How can you help my business rank?',
      'What do AEO & GEO mean?',
      'Can I book a call?',
    ];
    let suggestionsEl: HTMLElement | null = null;

    function renderSuggestions() {
      if (suggestionsEl) return;
      const wrap = document.createElement('div');
      wrap.className = 'rr-chat__suggestions';
      wrap.setAttribute('role', 'group');
      wrap.setAttribute('aria-label', 'Suggested questions');
      for (const question of SUGGESTIONS) {
        const chip = document.createElement('button');
        chip.type = 'button';
        chip.className = 'rr-chat__chip';
        chip.textContent = question;
        // Preserve click-to-send: the question text is the message.
        chip.addEventListener('click', () => sendMessage(question));
        wrap.appendChild(chip);
      }
      log!.appendChild(wrap);
      suggestionsEl = wrap;
      scrollToBottom();
    }

    function removeSuggestions() {
      if (suggestionsEl) {
        suggestionsEl.remove();
        suggestionsEl = null;
      }
    }

    function openPanel() {
      root!.setAttribute('data-open', 'true');
      panel!.hidden = false;
      launcher!.setAttribute('aria-expanded', 'true');
      // Opening the panel hides the launcher greeting popup immediately and
      // records today's date so the once-per-day popup won't reappear today.
      markGreetingShownToday();
      hideGreeting();
      // The Talk (voice) path speaks its own spoken greeting via voiceSession.ts.
      // The Type panel no longer renders a text greeting bubble; it opens with
      // just the suggestion pills. We still set greeted=true so the separate
      // daily-greeting bookkeeping continues to behave.
      if (currentMode === 'type') {
        greeted = true;
        if (!userHasMessaged) renderSuggestions();
      }
      // Move focus into the input on open (only relevant in Type mode).
      if (currentMode === 'type') window.setTimeout(() => input!.focus(), 50);
      // Reopening on Talk with no live session restores the idle panel
      // (transcript retained, Start talking available).
      if (currentMode === 'talk' && !voice) showTalkIdle();
    }

    function closePanel() {
      root!.setAttribute('data-open', 'false');
      panel!.hidden = true;
      launcher!.setAttribute('aria-expanded', 'false');
      launcher!.focus();
      // If a voice session is running, closing the panel ends it (wired below
      // via a close-button listener; declared here so ordering is explicit).
    }

    function togglePanel() {
      if (root!.getAttribute('data-open') === 'true') closePanel();
      else openPanel();
    }

    function setStreaming(state: boolean) {
      isStreaming = state;
      if (!sendBtn) return;
      // While streaming the composer button becomes Stop (same 40px pill
      // target, square glyph, updated label); otherwise it sends.
      if (state) {
        sendBtn.disabled = false;
        sendBtn.setAttribute('aria-label', 'Stop generating');
        sendBtn.innerHTML = '<span class="rr-chat__stop-icon" aria-hidden="true"></span>';
      } else {
        sendBtn.disabled = false;
        sendBtn.setAttribute('aria-label', 'Send message');
        sendBtn.innerHTML = SEND_ICON_HTML;
      }
    }

    function autoGrow() {
      input!.style.height = 'auto';
      input!.style.height = Math.min(input!.scrollHeight, 112) + 'px';
    }

    // Typing indicator: animated dots inside the placeholder bubble until the
    // first stream token arrives. Static under prefers-reduced-motion (CSS).
    function showTyping(el: HTMLElement) {
      el.classList.add('rr-chat__msg--typing');
      el.innerHTML =
        '<span class="rr-chat__dot" aria-hidden="true"></span><span class="rr-chat__dot" aria-hidden="true"></span><span class="rr-chat__dot" aria-hidden="true"></span>';
      el.setAttribute('aria-label', 'Assistant is typing');
    }

    function hideTyping(el: HTMLElement) {
      el.classList.remove('rr-chat__msg--typing');
      el.innerHTML = '';
      el.removeAttribute('aria-label');
    }

    // Single paint funnel for assistant text. Plain text for now; the
    // markdown-lite unit upgrades this one spot so streaming, retry, and
    // abort paths all render identically.
    function paintAssistant(el: HTMLElement, text: string) {
      el.innerHTML = renderRichText(text);
    }

    // Escape-first HTML encoder: model output is untrusted, so &<>" are
    // encoded BEFORE any markdown transform runs. Only the whitelisted
    // elements below (strong/code/a/ul/li/br) can appear in the output.
    function escapeHtml(s: string): string {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    // Inline formatting on already-escaped text: `code`, **bold**,
    // [label](url) links (site-relative or http(s) only), and bare site paths
    // like /book-a-call. Anything else renders as literal text.
    function inlineFmt(s: string): string {
      let out = s.replace(/`([^`]+)`/g, '<code>$1</code>');
      out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      out = out.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_m, t: string, u: string) => {
        if (u.startsWith('/')) {
          return `<a class="rr-chat__link" href="${u}">${t}</a>`;
        }
        if (/^https?:\/\//i.test(u)) {
          return `<a class="rr-chat__link" href="${u}" target="_blank" rel="noopener">${t}</a>`;
        }
        return `${t} (${u})`;
      });
      // Bare site paths (not already inside an href="...").
      out = out.replace(
        /(href="[^"]*")|(?<![\w/"'])\/(book-a-call|pricing|contact|check|calculator|services(?:\/[a-z-]+)?|blog(?:\/[a-z0-9-]+)?)(?![\w/-])/g,
        (m: string, href: string | undefined, path: string | undefined) =>
          href ? m : `<a class="rr-chat__link" href="/${path}">${'/' + path}</a>`
      );
      return out;
    }

    // Line-level rendering: "- "/"* " lines become a <ul>, everything else a
    // <br>-separated span. Runs on every stream chunk — cheap at chat sizes.
    function renderRichText(raw: string): string {
      const lines = escapeHtml(raw).split('\n');
      let html = '';
      let inList = false;
      for (const line of lines) {
        const item = line.match(/^\s*[-*] +(.*)$/);
        if (item) {
          if (!inList) {
            html += '<ul class="rr-chat__list">';
            inList = true;
          }
          html += `<li>${inlineFmt(item[1])}</li>`;
        } else {
          if (inList) {
            html += '</ul>';
            inList = false;
          }
          html += `<span>${inlineFmt(line)}</span><br>`;
        }
      }
      if (inList) html += '</ul>';
      return html;
    }

    // Error bubble with a Retry button that resends the failed turn WITHOUT
    // echoing a duplicate user bubble or re-pushing history.
    function addRetryableError(text: string, retryText: string): void {
      const el = addBubble('error', text);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'rr-chat__retry';
      btn.textContent = 'Try again';
      btn.addEventListener('click', () => {
        el.remove();
        sendMessage(retryText, { echoUser: false });
      });
      el.appendChild(btn);
      scrollToBottom();
    }

    async function sendMessage(text: string, opts: { echoUser?: boolean } = {}) {
      const { echoUser = true } = opts;
      const trimmed = text.trim();
      if (!trimmed || isStreaming) return;

      // First user message: clear the starter prompt cards so they don't clutter.
      removeSuggestions();
      userHasMessaged = true;

      if (echoUser) {
        messages.push({ role: 'user', content: trimmed });
        addBubble('user', trimmed);
        lastUserText = trimmed;
      }
      input!.value = '';
      autoGrow();
      setStreaming(true);

      // Placeholder assistant bubble that fills as the stream arrives.
      const assistantEl = addBubble('assistant', '');
      showTyping(assistantEl);
      let assistantText = '';
      let firstToken = true;
      let aborted = false;
      streamAbort = new AbortController();

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages, conversationId, ...getClientVisitorData() }),
          signal: streamAbort.signal,
        });

        if (!res.ok || !res.body) {
          throw new Error('Request failed: ' + res.status);
        }

        // Capture the conversation id from the first reply and persist it.
        const cid = res.headers.get('X-Conversation-Id');
        if (cid && !conversationId) {
          conversationId = cid;
          try {
            sessionStorage.setItem(CID_KEY, cid);
          } catch {
            /* sessionStorage may be unavailable; threading still works in-memory */
          }
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          // Keep the last, possibly-incomplete line in the buffer.
          buffer = lines.pop() ?? '';

          for (const rawLine of lines) {
            const line = rawLine.trim();
            if (!line.startsWith('data:')) continue;

            const data = line.slice(5).trim();
            if (data === '[DONE]' || data === '') continue;

            try {
              const parsed = JSON.parse(data);
              // Workers AI may emit a token as a raw JSON number (prices,
              // counts) — stringify instead of dropping, or "$35" shows as "$".
              const tok =
                typeof parsed.response === 'string'
                  ? parsed.response
                  : typeof parsed.response === 'number'
                    ? String(parsed.response)
                    : '';
              if (tok) {
                if (firstToken) {
                  firstToken = false;
                  hideTyping(assistantEl);
                }
                assistantText += tok;
                paintAssistant(assistantEl, assistantText);
                scrollToBottom();
              }
            } catch {
              /* Ignore malformed / partial JSON chunks. */
            }
          }
        }

        if (assistantText) {
          messages.push({ role: 'assistant', content: assistantText });
        } else if (!aborted) {
          assistantEl.remove();
          addRetryableError("I didn't get a response that time. Please try again.", lastUserText || trimmed);
        }
      } catch (err) {
        if (err instanceof DOMException && err.name === 'AbortError') {
          // User pressed Stop: keep whatever arrived (if anything) and stay
          // silent — no error bubble for an intentional stop.
          aborted = true;
          if (assistantText) {
            messages.push({ role: 'assistant', content: assistantText });
          } else {
            assistantEl.remove();
          }
        } else {
          assistantEl.remove();
          addRetryableError(
            'Something went wrong reaching the assistant. Please check your connection and try again.',
            lastUserText || trimmed
          );
        }
      } finally {
        streamAbort = null;
        setStreaming(false);
        input!.focus();
      }
    }

    // Composer submit: while streaming, submit acts as Stop; otherwise it sends.
    function handleComposerSubmit() {
      if (isStreaming) {
        streamAbort?.abort();
        return;
      }
      sendMessage(input!.value);
    }

    // ---- Wiring (text/SSE path, unchanged) ------------------------------
    launcher.addEventListener('click', togglePanel);
    closeBtn.addEventListener('click', closePanel);

    // Re-open in Type mode: the composer starts visible; the text path is
    // active unless the user explicitly taps Talk.
    selectModeButton('type');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleComposerSubmit();
    });

    input.addEventListener('input', autoGrow);

    // Enter sends; Shift+Enter inserts a newline. While streaming, Enter
    // stops generation instead.
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleComposerSubmit();
      }
    });

    // Escape closes when the panel is open.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root!.getAttribute('data-open') === 'true') {
        closePanel();
      }
    });

    // ---- Voice mode (Talk) ----------------------------------------------
    // Wired here so it shares addBubble/scrollToBottom and the same panel. The
    // text/SSE path above is completely untouched — voice only activates when
    // the user taps the Talk tab.
    let voice: VoiceSession | null = null;
    // True when the most recent session end was the user's own Stop press
    // (vs an unexpected drop). Drives the idle panel wording; never switches
    // modes — Talk stays put in every case.
    let userStoppedVoice = false;
    // First-visit Talk hint is rendered once per page load.
    let talkHintShown = false;

    // Live transcript bubbles for the in-flight turn (replaced in place until
    // finalized, so the user sees words appear as they are spoken).
    let liveUserEl: HTMLElement | null = null;
    let liveAssistantEl: HTMLElement | null = null;

    function setLiveIndicator(on: boolean) {
      modes!.setAttribute('data-live', on ? 'true' : 'false');
    }

    // Prominent voice status bar: show while connecting/live, hide otherwise.
    // The Stop / Start action buttons are mutually exclusive: Stop only
    // while a session is live, Start (talking/Reconnect) only when idle.
    function setVoiceUI(state: VoiceState) {
      if (!voicebar) return;
      if (state === 'requesting-token' || state === 'connecting') {
        if (voicebarLabel) voicebarLabel.textContent = 'Connecting…';
        voicebar.setAttribute('data-phase', 'connecting');
        if (voiceStopBtn) voiceStopBtn.hidden = false;
        if (voiceStartBtn) voiceStartBtn.hidden = true;
        voicebar.hidden = false;
      } else if (state === 'live') {
        if (voicebarLabel) voicebarLabel.textContent = 'Listening…';
        voicebar.setAttribute('data-phase', 'live');
        if (voiceStopBtn) voiceStopBtn.hidden = false;
        if (voiceStartBtn) voiceStartBtn.hidden = true;
        voicebar.hidden = false;
      } else if (state === 'error') {
        // Keep the bar visible on error so the Talk-only message (set by
        // showVoiceError) stays on screen; do not hide it here.
        return;
      } else {
        // idle | closing → hide the bar.
        voicebar.hidden = true;
        voicebar.removeAttribute('data-phase');
      }
    }

    function selectModeButton(mode: 'type' | 'talk') {
      const isType = mode === 'type';
      modeTypeBtn!.classList.toggle('rr-chat__mode--active', isType);
      modeTalkBtn!.classList.toggle('rr-chat__mode--active', !isType);
      modeTypeBtn!.setAttribute('aria-selected', isType ? 'true' : 'false');
      modeTalkBtn!.setAttribute('aria-selected', !isType ? 'true' : 'false');
      // Hide the text composer while talking; it stays available in Type mode.
      form!.style.display = isType ? '' : 'none';
      // Segregate the message surface: show only the active mode's log so
      // Talk transcripts and Text chat never stack or overlap.
      log!.classList.toggle('rr-chat__log--hidden', !isType);
      voicelog?.classList.toggle('rr-chat__log--hidden', isType);
    }

    function renderUserTranscript(text: string, final: boolean) {
      // Voice transcripts go to the Talk-only surface (#rr-chat-voicelog),
      // never the shared Text chat log.
      const target = voicelog ?? log!;
      if (!liveUserEl) liveUserEl = addBubbleTo(target, 'user', text);
      else {
        liveUserEl.textContent = text;
        scrollToBottom();
      }
      if (final) liveUserEl = null; // next interim text starts a fresh bubble
    }

    function renderAssistantTranscript(text: string, final: boolean) {
      const target = voicelog ?? log!;
      if (!liveAssistantEl) liveAssistantEl = addBubbleTo(target, 'assistant', text);
      else {
        liveAssistantEl.textContent = text;
        scrollToBottom();
      }
      if (final) liveAssistantEl = null;
    }

    function startVoice() {
      removeSuggestions();
      userStoppedVoice = false;
      liveUserEl = null;
      liveAssistantEl = null;
      // Fresh Talk session: clear any lingering error phase from a prior attempt.
      voicebar?.removeAttribute('data-phase');

      // Temp in-session memory: keep prior Talk transcript visible. If there's
      // already history, add a subtle divider before the new session's bubbles.
      if (voicelog && voicelog.childElementCount > 0) {
        const divider = document.createElement('div');
        divider.className = 'rr-chat__voice-divider';
        divider.setAttribute('role', 'separator');
        voicelog.appendChild(divider);
      }

      voice = new VoiceSession({
        // Feed the finalized turns retained across this page session into the
        // new Live session so the assistant remembers earlier Talk exchanges
        // (in-session voice memory), not just the visible transcript.
        onState: (state: VoiceState) => {
          setLiveIndicator(state === 'live');
          // Drive the prominent voice status bar (connecting/listening/Stop).
          setVoiceUI(state);
          // Session ended (user Stop OR unexpected drop/error): stay on Talk
          // in every case. The idle panel takes over — a Stop shows Start
          // talking, a drop shows Reconnect. Nothing here switches modes.
          if (state === 'idle') {
            if (currentMode === 'talk') showTalkIdle({ action: userStoppedVoice ? 'start' : 'reconnect' });
          }
        },
        onUserTranscript: renderUserTranscript,
        onAssistantTranscript: renderAssistantTranscript,
        // Retain every finalized voice turn for this page session so the next
        // Live session can be seeded with it (in-session voice memory). Same
        // pattern as the typed-text `messages.push(...)` calls.
        onTurnFinalized: (turn: VoiceTurn) => {
          voiceTurns.push(turn);
        },
        // Mic/voice errors belong to the Talk section only — never surface them
        // in the shared text chat (#rr-chat-log). Show them on the Talk-only
        // voice bar (label) and keep the mode on Talk so onState's idle/error
        // fall-back to Type doesn't leak the error into the text composer.
        onError: (message: string) => showVoiceError(message),
      }, {
        // Seed the new Live session with the turns retained so far this page
        // session (in-session voice memory). Empty on the first session.
        priorTurns: voiceTurns,
      });
      voice.start();
    }

    // Talk idle panel: voicebar becomes the "off" state with a Start talking /
    // Reconnect action. Talk-only (never touches Type), transcript retained.
    // Focus moves to the action only on explicit user paths (Stop press, tab
    // entry) — never on an async drop, which must not steal focus.
    function showTalkIdle(opts: { focusStart?: boolean; action?: 'start' | 'reconnect' } = {}) {
      if (!voicebar || currentMode !== 'talk') return;
      const action = opts.action ?? 'start';
      voicebar.removeAttribute('data-phase');
      voicebar.setAttribute('data-phase', 'idle');
      if (voicebarLabel) voicebarLabel.textContent = 'Voice off';
      if (voiceStopBtn) voiceStopBtn.hidden = true;
      if (voiceStartBtn) {
        voiceStartBtn.textContent = action === 'reconnect' ? 'Reconnect' : 'Start talking';
        voiceStartBtn.hidden = false;
      }
      voicebar.hidden = false;
      // First visit: one-line explainer above the idle bar (once per load).
      if (!talkHintShown && voicelog && voicelog.childElementCount === 0) {
        talkHintShown = true;
        const hint = document.createElement('p');
        hint.className = 'rr-chat__voice-hint';
        hint.textContent = 'Talk with Omli by voice. Press Start talking, then allow the microphone when asked.';
        voicelog.prepend(hint);
      }
      scrollToBottom();
      if (opts.focusStart && voiceStartBtn && panelIsOpen()) voiceStartBtn.focus();
    }

    // Surface a mic/voice error on the Talk-only voice bar (never in the
    // shared text chat log) with a Reconnect action. Stays on Talk — the
    // error and transcript are preserved for the retry.
    function showVoiceError(message: string) {
      if (voicebar && voicebarLabel) {
        // Mic-denied gets explicit next-step guidance; other errors keep the
        // server-provided text and lean on the adjacent Reconnect button.
        const micDenied = /microphone|permission|not-allowed|notfound/i.test(message);
        voicebarLabel.textContent = micDenied
          ? 'Microphone access was blocked. Allow it in the browser address bar, then press Reconnect.'
          : message;
        voicebar.setAttribute('data-phase', 'error');
        if (voiceStopBtn) voiceStopBtn.hidden = true;
        if (voiceStartBtn) {
          voiceStartBtn.textContent = 'Reconnect';
          voiceStartBtn.hidden = false;
        }
        voicebar.hidden = false;
      }
    }

    function stopVoice() {
      // User-initiated stop: the idle panel takes over on Talk (never a mode
      // switch). userStoppedVoice marks the intent; the async 'idle' event
      // re-renders the same panel idempotently via onState.
      userStoppedVoice = true;
      setLiveIndicator(false);
      // Clear any error phase and hide the voice status bar immediately.
      voicebar?.removeAttribute('data-phase');
      setVoiceUI('idle');
      liveUserEl = null;
      liveAssistantEl = null;
      if (voice) {
        voice.stop();
        voice = null;
      }
      if (currentMode === 'talk') showTalkIdle({ focusStart: true, action: 'start' });
    }

    function switchMode(mode: 'type' | 'talk') {
      if (mode === currentMode) return;
      currentMode = mode;
      // selectModeButton toggles the visible message surface so only the active
      // mode's log shows (Type → #rr-chat-log, Talk → #rr-chat-voicelog).
      selectModeButton(mode);
      // Keep the now-active log scrolled to the latest message.
      scrollToBottom();
      if (mode === 'talk') {
        // Entering Talk never auto-starts the mic: the tab is a place you can
        // stay with voice off. Listening begins only via Start talking /
        // Reconnect. Focus moves there so keyboard users can start immediately.
        if (!voice) showTalkIdle({ focusStart: true, action: 'start' });
      } else {
        if (voice) stopVoice();
        // Back in Type mode: show the starter pills again until the user's
        // first message. Voice/Talk still clears them via startVoice.
        if (!userHasMessaged) renderSuggestions();
      }
    }

    modeTypeBtn.addEventListener('click', () => switchMode('type'));
    modeTalkBtn.addEventListener('click', () => switchMode('talk'));

    // Stop button on the voice bar: end voice and stay on Talk — the idle
    // panel (Start talking) takes over. stopVoice() clears any error phase.
    voiceStopBtn?.addEventListener('click', () => {
      stopVoice();
    });

    // Idle-phase action: Start talking after a Stop, Reconnect after a drop
    // or error. startVoice() resets the bar via the state machine.
    voiceStartBtn?.addEventListener('click', () => {
      startVoice();
    });

    // Tear the voice session down if the panel closes or the page unloads.
    closeBtn.addEventListener('click', stopVoice);
    window.addEventListener('beforeunload', stopVoice);

    // ---- Launcher greeting popup ----------------------------------------
    // Once-per-day gating via localStorage: the popup shows at most once per
    // calendar day. The key stores today's date as YYYY-MM-DD; when the stored
    // value already equals today, the popup is suppressed. After the day rolls
    // over (or on a refresh on a new day) it becomes eligible again.
    const GREETING_DATE_KEY = 'omli_greeting_date';

    function todayKey(): string {
      const d = new Date();
      const mm = String(d.getMonth() + 1).padStart(2, '0');
      const dd = String(d.getDate()).padStart(2, '0');
      return d.getFullYear() + '-' + mm + '-' + dd;
    }

    function greetingShownToday(): boolean {
      try {
        return localStorage.getItem(GREETING_DATE_KEY) === todayKey();
      } catch {
        return false; // localStorage unavailable → treat as not-yet-shown
      }
    }

    function markGreetingShownToday(): void {
      try {
        localStorage.setItem(GREETING_DATE_KEY, todayKey());
      } catch {
        /* localStorage may be unavailable; gating degrades to per-load only */
      }
    }

    // Session-local flag so a dismiss/close hides it for the rest of this load
    // even before the day rolls over (complements the localStorage day gate).
    let greetingDismissed = false;
    let greetingHideTimer: number | null = null;
    let greetingReshowTimer: number | null = null;

    function panelIsOpen(): boolean {
      return root!.getAttribute('data-open') === 'true';
    }

    function showGreeting() {
      if (!greeting) return;
      if (greetingDismissed || panelIsOpen()) return;
      // Once-per-day: skip if we've already shown it today.
      if (greetingShownToday()) return;
      // Record today's date so it won't show again until the day rolls over.
      markGreetingShownToday();
      greeting.hidden = false;
      // Force a reflow so the transition runs when toggling the shown flag.
      void greeting.offsetWidth;
      greeting.setAttribute('data-shown', 'true');
      // Auto-hide after ~7s, then re-show every ~25s while eligible.
      if (greetingHideTimer !== null) window.clearTimeout(greetingHideTimer);
      greetingHideTimer = window.setTimeout(() => {
        hideGreeting();
        if (greetingReshowTimer !== null) window.clearTimeout(greetingReshowTimer);
        greetingReshowTimer = window.setTimeout(() => {
          if (!greetingDismissed && !panelIsOpen()) showGreeting();
        }, 25000);
      }, 7000);
    }

    function hideGreeting() {
      if (!greeting) return;
      greeting.setAttribute('data-shown', 'false');
      greeting.hidden = true;
      if (greetingHideTimer !== null) {
        window.clearTimeout(greetingHideTimer);
        greetingHideTimer = null;
      }
    }

    function dismissGreeting() {
      greetingDismissed = true;
      // Persist today's date so the once-per-day gate also suppresses it on
      // subsequent loads within the same day.
      markGreetingShownToday();
      hideGreeting();
      if (greetingReshowTimer !== null) {
        window.clearTimeout(greetingReshowTimer);
        greetingReshowTimer = null;
      }
    }

    greetingCloseBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      dismissGreeting();
    });

    // First reveal ~1.5s after load, only while the panel is closed and if the
    // once-per-day gate hasn't already been satisfied today.
    window.setTimeout(() => {
      if (!greetingDismissed && !panelIsOpen() && !greetingShownToday()) showGreeting();
    }, 1500);
  }
</script>
