---
/**
 * Cal.com embed bootstrap. Mounted once per page from the layout.
 *
 * Any element carrying the booking attributes opens the scheduler as a modal:
 *
 *   <a href="/book-a-call"
 *      data-cal-namespace="discovery"
 *      data-cal-link="renderandrank/discovery">Book a call</a>
 *
 * `BookCallButton.astro` wraps that contract, and the inline calendar on
 * /book-a-call reuses this namespace via `CalInline.astro`.
 *
 * We bind the click ourselves rather than relying on the embed's own DOM scan:
 * this script runs in `<head>`, so that scan can complete before the body has
 * parsed and find nothing to attach to. Binding through a delegated listener
 * also means the `href` stays a real link — modifier-clicks and middle-clicks
 * still open /book-a-call in a new tab, and with JS off it is the only
 * behaviour.
 */
import { siteConfig } from '../config/site';

const { calCom } = siteConfig;
---

<script
  is:inline
  define:vars={{
    namespace: calCom.namespace,
    brand: calCom.brandColor,
  }}
>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', namespace, { origin: 'https://app.cal.com' });

  // Match the scheduler to the site: monochrome brand, 8px radius.
  Cal.ns[namespace]('ui', {
    theme: 'light',
    cssVarsPerTheme: {
      light: {
        'cal-brand': brand,
        'cal-border-radius': '8px',
      },
    },
    hideEventTypeDetails: false,
    layout: 'month_view',
  });

  document.addEventListener('click', function (event) {
    // Leave modified and non-primary clicks to the browser so the link keeps
    // working the way a link should.
    if (event.defaultPrevented) return;
    if (event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const trigger = event.target.closest('[data-cal-link]');
    if (!trigger) return;

    const ns = trigger.getAttribute('data-cal-namespace') || namespace;
    const api = window.Cal && window.Cal.ns && window.Cal.ns[ns];
    if (!api) return; // embed unavailable — fall through to the href

    let config = { layout: 'month_view' };
    const raw = trigger.getAttribute('data-cal-config');
    if (raw) {
      try {
        config = JSON.parse(raw);
      } catch {
        /* keep the default layout */
      }
    }

    event.preventDefault();
    api('modal', {
      calLink: trigger.getAttribute('data-cal-link'),
      config: config,
    });
  });
</script>
