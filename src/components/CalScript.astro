---
/**
 * Cal.com embed bootstrap. Mounted once per page from the layout.
 *
 * Booking CTAs across the site are plain links to /book-a-call, where the
 * scheduler is inlined and preloaded via `CalInline.astro` (which reuses the
 * namespace initialised here). There is no click-to-open modal: routing to the
 * dedicated page avoids the click-time embed fetch that made the popup feel
 * slow, while the calendar is already warm when the visitor arrives.
 *
 * A completed booking re-dispatches as an `rr:booking-confirmed` DOM event on
 * `document`, carrying Cal's payload in `detail`.
 */
import { siteConfig } from '../config/site';

const { calCom } = siteConfig;
---

<script
  is:inline
  define:vars={{
    namespace: calCom.namespace,
    brand: calCom.brandColor,
  }}
>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', namespace, { origin: 'https://app.cal.com' });

  // Match the scheduler to the site: monochrome brand, 8px radius.
  Cal.ns[namespace]('ui', {
    theme: 'light',
    cssVarsPerTheme: {
      light: {
        'cal-brand': brand,
        'cal-border-radius': '8px',
      },
    },
    hideEventTypeDetails: false,
    layout: 'column_view',
  });

  // Cal fires this from inside the iframe once the booking actually exists.
  // Re-dispatching it as a DOM event keeps the embed API in this one file:
  // `CalInline.astro` swaps in its confirmation off `rr:booking-confirmed`
  // without importing anything, and further listeners (analytics, a pixel) can
  // hook the same event later.
  Cal.ns[namespace]('on', {
    action: 'bookingSuccessful',
    callback: function (event) {
      document.dispatchEvent(
        new CustomEvent('rr:booking-confirmed', {
          detail: (event && event.detail) || null,
        })
      );
    },
  });

  // Analytics beacon: fire-and-forget a POST to /api/booking when a booking is
  // confirmed. Hooks the same `rr:booking-confirmed` event `CalInline.astro`
  // uses for its toast (this is the "further listeners" mentioned above). The
  // body carries the client marketing/referrer context (server derives
  // geo/device itself) merged with any booking detail Cal exposes on the event.
  // Never blocks the UI and never throws into the page.
  document.addEventListener(
    'rr:booking-confirmed',
    function (event) {
      try {
        // Collect the visitor's marketing/referrer context in the BROWSER, at
        // event time. Inlined here because this <script> uses define:vars and is
        // therefore rendered inline and NOT bundled — an ESM import of
        // getClientVisitorData would not resolve in the browser, and calling it
        // through define:vars would run at SSR (window undefined → all null).
        function readVisitorData() {
          var params = new URLSearchParams(window.location.search);
          return {
            referrer: document.referrer || null,
            landing_page: window.location.href,
            utm_source: params.get('utm_source') || null,
            utm_medium: params.get('utm_medium') || null,
            utm_campaign: params.get('utm_campaign') || null,
            utm_term: params.get('utm_term') || null,
            utm_content: params.get('utm_content') || null,
          };
        }
        var clientVisitor = readVisitorData();

        // Cal's payload, when present, lives under event.detail.data.
        var detail = (event && event.detail) || {};
        var data = detail.data || detail || {};
        var attendee = data.attendee || {};

        function firstNonEmpty() {
          for (var i = 0; i < arguments.length; i++) {
            var v = arguments[i];
            if (typeof v === 'string' && v.trim()) return v.trim();
          }
          return undefined;
        }

        var booking = {
          name: firstNonEmpty(data.attendeeName, attendee.name),
          email: firstNonEmpty(data.email, attendee.email),
          timezone: firstNonEmpty(attendee.timeZone, data.timeZone, data.timezone),
          event_type: firstNonEmpty(
            data.eventType && data.eventType.slug,
            typeof data.eventType === 'string' ? data.eventType : undefined,
            data.eventTypeSlug
          ),
        };

        // Merge client visitor context with the booking detail; drop undefined
        // keys so we only send what we actually have.
        var payload = Object.assign({}, clientVisitor);
        Object.keys(booking).forEach(function (key) {
          if (booking[key] !== undefined) payload[key] = booking[key];
        });

        var bodyStr = JSON.stringify(payload);

        // Prefer sendBeacon (survives the navigation Cal may trigger); fall
        // back to fetch with keepalive so the request still completes.
        var sent = false;
        if (navigator && typeof navigator.sendBeacon === 'function') {
          try {
            var blob = new Blob([bodyStr], { type: 'application/json' });
            sent = navigator.sendBeacon('/api/booking', blob);
          } catch (e) {
            sent = false;
          }
        }
        if (!sent) {
          fetch('/api/booking', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: bodyStr,
            keepalive: true,
          }).catch(function () {
            /* fire-and-forget: never surface a beacon failure to the visitor */
          });
        }
      } catch (e) {
        /* Analytics must never break the booking UX. */
      }
    }
  );

  // Every booking CTA on the site is now a plain link to /book-a-call, where
  // the scheduler is inlined and preloaded (see CalInline.astro). We no longer
  // open a modal on click, so there is no popup trigger to bind here.
</script>
