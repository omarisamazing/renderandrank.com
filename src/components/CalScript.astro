---
/**
 * Cal.com embed bootstrap. Mounted once per page from the layout.
 *
 * Booking CTAs across the site are plain links to /book-a-call, where the
 * scheduler is inlined and preloaded via `CalInline.astro` (which reuses the
 * namespace initialised here). There is no click-to-open modal: routing to the
 * dedicated page avoids the click-time embed fetch that made the popup feel
 * slow, while the calendar is already warm when the visitor arrives.
 *
 * A completed booking re-dispatches as an `rr:booking-confirmed` DOM event on
 * `document`, carrying Cal's payload in `detail`.
 */
import { siteConfig } from '../config/site';

const { calCom } = siteConfig;
---

<script
  is:inline
  define:vars={{
    namespace: calCom.namespace,
    brand: calCom.brandColor,
  }}
>
  (function (C, A, L) {
    let p = function (a, ar) {
      a.q.push(ar);
    };
    let d = C.document;
    C.Cal =
      C.Cal ||
      function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () {
            p(api, arguments);
          };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  Cal('init', namespace, { origin: 'https://app.cal.com' });

  // Match the scheduler to the site: monochrome brand, 8px radius.
  Cal.ns[namespace]('ui', {
    theme: 'light',
    cssVarsPerTheme: {
      light: {
        'cal-brand': brand,
        'cal-border-radius': '8px',
      },
    },
    hideEventTypeDetails: false,
    layout: 'column_view',
  });

  // Cal fires this from inside the iframe once the booking actually exists.
  // Re-dispatching it as a DOM event keeps the embed API in this one file:
  // `CalInline.astro` swaps in its confirmation off `rr:booking-confirmed`
  // without importing anything, and further listeners (analytics, a pixel) can
  // hook the same event later.
  Cal.ns[namespace]('on', {
    action: 'bookingSuccessful',
    callback: function (event) {
      document.dispatchEvent(
        new CustomEvent('rr:booking-confirmed', {
          detail: (event && event.detail) || null,
        })
      );
    },
  });

  // Every booking CTA on the site is now a plain link to /book-a-call, where
  // the scheduler is inlined and preloaded (see CalInline.astro). We no longer
  // open a modal on click, so there is no popup trigger to bind here.
</script>
