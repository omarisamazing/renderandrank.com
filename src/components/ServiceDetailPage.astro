---
/**
 * ServiceDetailPage — shared service-detail body. The three detail pages
 * differ only by slug (data comes from `src/data/services.ts`); per-page
 * config (color block, lede, related posts) lives here so the EN page and
 * all six locale wrappers stay in sync with zero forks.
 */
import ServiceDetail from './ServiceDetail.astro';
import CtaBanner from './CtaBanner.astro';
import { services } from '../data/services';
import { servicesDict } from '../i18n/servicesDict';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  slug: 'local-seo' | 'aeo-geo' | 'google-maps';
}

const { slug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;
const source = lang === 'en' ? services : (servicesDict[lang] ?? services);
const service = source.find((s) => s.slug === slug)!;

const ledes = {
  'local-seo': t('service.lede.local-seo'),
  'aeo-geo': t('service.lede.aeo-geo'),
  'google-maps': t('service.lede.google-maps'),
} as const;

const config = {
  'local-seo': {
    block: 'cream',
    lede: ledes['local-seo'],
    relatedPosts: [
      {
        title: 'Local Citations and NAP Consistency: The Complete Guide',
        description: 'Why consistent records decide Maps rank — and how to clean them up.',
        href: `${prefix}/blog/local-citations-nap-consistency-guide/`,
      },
      {
        title: 'Google Review Velocity: The SMS Pipeline That Moves Maps Rankings',
        description: 'How a steady flow of authentic reviews lifts 3-pack rank.',
        href: `${prefix}/blog/google-reviews-velocity-maps-rankings-sms-pipeline/`,
      },
    ],
  },
  'aeo-geo': {
    block: 'lilac',
    lede: ledes['aeo-geo'],
    relatedPosts: [
      {
        title: 'How ChatGPT Finds Local Businesses: The 4 Pathways of AI Information',
        description: 'Training, live retrieval, licensing, direct APIs — and how to show up in each.',
        href: `${prefix}/blog/ai-visibility-local-business-chatgpt-gemini-perplexity/`,
      },
      {
        title: 'Google Maps 3-Pack Ranking Factors: The Geo-Grid Method',
        description: 'The Maps foundation every AI citation stands on.',
        href: `${prefix}/blog/google-maps-3-pack-ranking-factors-geo-grid/`,
      },
    ],
  },
  'google-maps': {
    block: 'mint',
    lede: ledes['google-maps'],
    relatedPosts: [
      {
        title: 'Google Maps 3-Pack Ranking Factors: The Geo-Grid Method',
        description: 'How the pack is actually won: proximity, categories, reviews, spam suppression.',
        href: `${prefix}/blog/google-maps-3-pack-ranking-factors-geo-grid/`,
      },
      {
        title: 'Google Review Velocity: The SMS Pipeline That Moves Maps Rankings',
        description: 'How a steady flow of authentic reviews lifts 3-pack rank.',
        href: `${prefix}/blog/google-reviews-velocity-maps-rankings-sms-pipeline/`,
      },
    ],
  },
} as const;

const { block, lede, relatedPosts } = config[slug];
---

<ServiceDetail
  service={service}
  block={block}
  lede={lede}
  relatedPosts={[...relatedPosts]}
/>
<CtaBanner />
