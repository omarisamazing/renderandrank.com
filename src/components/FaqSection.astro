---
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import BookCallButton from './BookCallButton.astro';
import { FaqAccordion } from './faq/FaqAccordion';
import { faqs } from '../data/faqs';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Section id="faq">
  <div class="color-block color-block-lime color-block--bleed">
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <Eyebrow tone="on-block" data-reveal>Questions</Eyebrow>
      <h2 class="display-md mt-4 text-ink" data-reveal>
        The things people ask before they book
      </h2>
    </div>

    <div class="mx-auto mt-12 max-w-3xl md:mt-14" data-reveal>
      <FaqAccordion client:visible items={faqs} />
    </div>

    <div
      class="mx-auto mt-12 flex max-w-3xl flex-col items-center gap-4 border-t border-black/10 pt-8 sm:flex-row sm:justify-between"
    >
      <p class="body-sm text-ink">Something not covered here?</p>
      <div class="flex flex-wrap items-center gap-3">
        <Button href="/contact" variant="secondary" size="sm">Send a message</Button>
        <BookCallButton size="sm" label="Book a call" withIcon={false} />
      </div>
    </div>
  </div>
</Section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
