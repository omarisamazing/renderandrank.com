---
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import BookCallButton from './BookCallButton.astro';
import { FaqAccordion } from './faq/FaqAccordion';
import { faqs } from '../data/faqs';
import { faqDict } from '../i18n/faqDict';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  /**
   * White canvas by default. On every page that uses this section the next thing
   * down is the navy CTA banner, and DESIGN.md requires white canvas between two
   * blocks — so a lime FAQ panel here would always sit against a dark block.
   * Pass `lime` to opt a single page back into the coloured panel.
   */
  tone?: 'canvas' | 'lime';
}

const { tone = 'canvas' } = Astro.props;
const onBlock = tone === 'lime';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;
// EN stays on the canonical data file; locales read the transcreated dict.
const items = lang === 'en' ? faqs : (faqDict[lang] ?? faqs);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Section id="faq">
  <div
    class:list={[onBlock && 'color-block color-block-lime color-block--bleed']}
  >
    <div class="mx-auto max-w-2xl text-center" data-reveal-group>
      <Eyebrow tone={onBlock ? 'on-block' : 'ink'} data-reveal>{t('faq.eyebrow')}</Eyebrow>
      <h2 class="display-md mt-4 text-ink" data-reveal>
        {t('faq.title')}
      </h2>
    </div>

    <div class="mx-auto mt-12 max-w-3xl md:mt-14" data-reveal>
      <FaqAccordion client:visible items={items} surface={onBlock ? 'block' : 'canvas'} />
    </div>

    <div
      class:list={[
        'mx-auto mt-12 flex max-w-3xl flex-col items-center gap-4 border-t pt-8 sm:flex-row sm:justify-between',
        onBlock ? 'border-black/10' : 'border-hairline',
      ]}
    >
      <p class="body-sm text-ink">{t('faq.more')}</p>
      <div class="flex flex-wrap items-center gap-3">
        <Button href={`${prefix}/contact`} variant="secondary" size="sm">{t('faq.send')}</Button>
        <BookCallButton size="sm" withIcon={false} />
      </div>
    </div>
  </div>
</Section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
