---
import Section from './ui/Section.astro';
import Eyebrow from './ui/Eyebrow.astro';
import Button from './ui/Button.astro';
import BookCallButton from './BookCallButton.astro';
import { siteConfig } from '../config/site';
import { Check } from '@lucide/astro';
import { Picture } from 'astro:assets';
import founderAvatar from '../assets/founder-omar-ali.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'en' ? '' : `/${lang}`;

const commitments = [
  { title: t('founder.commit1t'), body: t('founder.commit1b') },
  { title: t('founder.commit2t'), body: t('founder.commit2b') },
];

const imgAlt = t('founder.imgAlt')
  .replace('{person}', siteConfig.founder.name)
  .replace('{brand}', siteConfig.name);
---

<!--
  White canvas, not a colour block: this sits between the pricing table and the
  lime audit form, and DESIGN.md requires white between every two blocks. The
  cards invert accordingly — soft tiles on white, rather than white cards on mint.
-->
<Section>
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
    <!-- Portrait -->
    <div class="lg:col-span-5" data-reveal>
      <div
        class="mx-auto w-full max-w-xs overflow-hidden rounded-lg border border-hairline bg-canvas lg:mx-0"
      >
        <Picture
          src={founderAvatar}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          alt={imgAlt}
          width={480}
          height={560}
          loading="lazy"
          decoding="async"
          class="aspect-[6/7] w-full object-cover object-top"
        />
      </div>

      <div class="mx-auto mt-6 max-w-xs text-center lg:mx-0 lg:text-left">
        <p class="card-title text-ink">{siteConfig.founder.name}</p>
        <p class="body-sm mt-1 text-ink">{siteConfig.founder.role}</p>
        <p class="caption mt-2 text-ink">
          {t('founder.location')}
        </p>
      </div>
    </div>

    <!-- Story -->
    <div class="lg:col-span-7" data-reveal-group data-reveal-delay="0.1">
      <Eyebrow data-reveal>{t('founder.eyebrow')}</Eyebrow>

      <h2 class="display-md mt-4 text-ink" data-reveal>
        {t('founder.title')}
      </h2>

      <div class="mt-6 flex flex-col gap-4" data-reveal>
        <p class="body text-ink">
          {t('founder.body1')}
        </p>
        <p class="body text-ink">
          {t('founder.body2')}
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2" data-reveal>
        {
          commitments.map((item) => (
            <div class="rounded-md border border-hairline bg-surface-soft p-4">
              <p class="label inline-flex items-center gap-2 text-ink">
                <Check class="size-4 shrink-0 text-success" aria-hidden="true" />
                {item.title}
              </p>
              <p class="caption mt-1.5 text-ink">{item.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal>
        <BookCallButton label={t('cta.bookWithOmar')} />
        <Button href={`${prefix}/about`} variant="secondary">{t('founder.ctaStory')}</Button>
      </div>
    </div>
  </div>
</Section>
