# ── Caching ──────────────────────────────────────────────
# Hashed build assets are safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts in public/fonts (non-hashed) - cache a week
/fonts/*
  Cache-Control: public, max-age=604800

# ── Security headers (all routes) ────────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://app.cal.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-src https://app.cal.com https://challenges.cloudflare.com; connect-src 'self' https://app.cal.com https://basemaps.cartocdn.com wss://generativelanguage.googleapis.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'
