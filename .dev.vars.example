# Copy this file to `.dev.vars` for local testing with `wrangler pages dev`.
# `.dev.vars` is git-ignored. In production these live in the Cloudflare
# Pages project settings (RESEND_API_KEY as an encrypted Secret).

# Resend API key (https://resend.com/api-keys). Required to deliver leads.
RESEND_API_KEY=re_your_key_here

# Inbox that receives contact-form submissions.
CONTACT_TO=hello@renderandrank.com

# Verified Resend sender. Use an address on a domain you verified in Resend.
CONTACT_FROM=Render and Rank <onboarding@resend.dev>

# Cal.com REST API key (https://app.cal.com/settings/developer/api-keys).
# Used server-side to fetch attendee name/email/timezone for a booking uid via
# GET /v2/bookings/{uid}. In production add it as an encrypted Pages Secret.
CALCOM_API_KEY=your-cal-com-api-key-here
# Google AI Studio (Gemini) API key. Used server-side by /api/check and
# /api/voice-token (to mint Gemini Live ephemeral auth tokens). In production
# add it as an encrypted Pages Secret.
GEMINI_API_KEY=your-gemini-api-key-here
